<Project>
    <!-- Local machine paths live in Directory.Build.props.user (gitignored, written by Setup.ps1), so this file can be
         committed. A value passed on the command line still wins:
           Dedicated64    folder containing SpaceEngineersDedicated.exe
           GameBinaries   folder containing the game assemblies the Torch plugin references (empty uses DS64, then
                          Dedicated64)
           TorchBinaries  folder containing Torch.dll and Torch.Server.exe; the Torch build needs it
           Magnetar       the Magnetar install folder
           MagnetarBin    folder containing PluginSdk.dll (empty derives it from Magnetar)
           Quasar         the Quasar data folder, to deploy the plugin after a build
           QuasarPluginAbstractionsAssembly and MagnetarProtocolAssembly   Quasar 1.7 assemblies, to build without a
                          ..\quasar checkout
           DS64           alias some projects use for the Dedicated Server folder
    -->
    <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
            Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

    <!-- A user who sets only one of the aliases gets the others from it; auto-detection then leaves them alone. -->
    <PropertyGroup>
        <GameBinaries Condition=" '$(GameBinaries)' == '' AND '$(DS64)' != '' ">$(DS64)</GameBinaries>
        <GameBinaries Condition=" '$(GameBinaries)' == '' AND '$(Dedicated64)' != '' ">$(Dedicated64)</GameBinaries>
        <Dedicated64 Condition=" '$(Dedicated64)' == '' AND '$(GameBinaries)' != '' ">$(GameBinaries)</Dedicated64>
    </PropertyGroup>

    <PropertyGroup>
        <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
        <PathSeparator Condition="$([MSBuild]::IsOSPlatform('Windows'))">\</PathSeparator>
        <PathSeparator Condition="!$([MSBuild]::IsOSPlatform('Windows'))">/</PathSeparator>
    </PropertyGroup>

    <PropertyGroup Condition=" !$([MSBuild]::IsOSPlatform('Windows')) ">
        <_UserHome>$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))</_UserHome>
    </PropertyGroup>

    <!-- Dedicated64 (Dedicated Server, Steam app 298740) -->
    <PropertyGroup>
        <_DsInstallLocation Condition=" '$(Dedicated64)' == '' AND $([MSBuild]::IsOSPlatform('Windows')) ">$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 298740@InstallLocation)</_DsInstallLocation>
        <Dedicated64 Condition=" '$(Dedicated64)' == '' AND '$(_DsInstallLocation)' != '' ">$(_DsInstallLocation)\DedicatedServer64</Dedicated64>
        <Dedicated64 Condition=" '$(Dedicated64)' == '' AND $([MSBuild]::IsOSPlatform('Windows')) AND Exists('C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineersDedicatedServer\DedicatedServer64') ">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineersDedicatedServer\DedicatedServer64</Dedicated64>
        <Dedicated64 Condition=" '$(Dedicated64)' == '' AND '$(_UserHome)' != '' AND Exists('$(_UserHome)/.steam/steam/steamapps/common/SpaceEngineersDedicatedServer/DedicatedServer64') ">$(_UserHome)/.steam/steam/steamapps/common/SpaceEngineersDedicatedServer/DedicatedServer64</Dedicated64>
        <Dedicated64 Condition=" '$(Dedicated64)' == '' AND '$(_UserHome)' != '' AND Exists('$(_UserHome)/.local/share/Steam/steamapps/common/SpaceEngineersDedicatedServer/DedicatedServer64') ">$(_UserHome)/.local/share/Steam/steamapps/common/SpaceEngineersDedicatedServer/DedicatedServer64</Dedicated64>
    </PropertyGroup>

    <!-- Magnetar: %AppData%\Magnetar on Windows, ~/.local/share/Magnetar on Linux -->
    <PropertyGroup>
        <Magnetar Condition=" '$(Magnetar)' == '' AND $([MSBuild]::IsOSPlatform('Windows')) ">$([System.Environment]::GetFolderPath(SpecialFolder.ApplicationData))\Magnetar</Magnetar>
        <Magnetar Condition=" '$(Magnetar)' == '' AND '$(_UserHome)' != '' ">$(_UserHome)/.local/share/Magnetar</Magnetar>

        <MagnetarBin Condition=" '$(MagnetarBin)' == '' AND '$(Magnetar)' != '' AND !$([MSBuild]::IsOSPlatform('Windows')) ">$([System.IO.Path]::Combine('$(Magnetar)', 'Bin'))</MagnetarBin>
        <!-- Windows: .NET Framework build -> MagnetarLegacy, .NET build -> MagnetarInterim -->
        <MagnetarBin Condition=" '$(MagnetarBin)' == '' AND '$(Magnetar)' != '' AND $([MSBuild]::IsOSPlatform('Windows')) AND $(TargetFramework.StartsWith('net4')) ">$([System.IO.Path]::Combine('$(Magnetar)', 'Libraries', 'MagnetarLegacy'))</MagnetarBin>
        <MagnetarBin Condition=" '$(MagnetarBin)' == '' AND '$(Magnetar)' != '' AND $([MSBuild]::IsOSPlatform('Windows')) AND '$(TargetFramework)' != '' AND !$(TargetFramework.StartsWith('net4')) ">$([System.IO.Path]::Combine('$(Magnetar)', 'Libraries', 'MagnetarInterim'))</MagnetarBin>
    </PropertyGroup>

    <!-- Torch game and server folders. No junctions or other links are used: the paths come from the user props, with
         Dedicated64 as the last fallback for the game folder. -->
    <PropertyGroup>
        <GameBinaries Condition=" '$(GameBinaries)' == '' AND '$(Dedicated64)' != '' ">$(Dedicated64)</GameBinaries>
        <DS64 Condition=" '$(DS64)' == '' AND '$(GameBinaries)' != '' ">$(GameBinaries)</DS64>
    </PropertyGroup>

    <!-- Reference folders with a trailing directory separator, for use in HintPath -->
    <PropertyGroup>
        <GameBinariesDir>$(GameBinaries)</GameBinariesDir>
        <GameBinariesDir Condition=" '$(GameBinariesDir)' != '' AND !HasTrailingSlash('$(GameBinariesDir)') ">$(GameBinariesDir)$(PathSeparator)</GameBinariesDir>

        <TorchBinariesDir>$(TorchBinaries)</TorchBinariesDir>
        <TorchBinariesDir Condition=" '$(TorchBinariesDir)' != '' AND !HasTrailingSlash('$(TorchBinariesDir)') ">$(TorchBinariesDir)$(PathSeparator)</TorchBinariesDir>
    </PropertyGroup>
</Project>
