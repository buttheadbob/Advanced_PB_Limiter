<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!-- Advanced PB Limiter Quasar UI plugin: the live report of a server's programmable blocks.
       Quasar builds it from QuasarHub, passing QuasarPluginAbstractionsAssembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AdvancedPBLimiter.Quasar</AssemblyName>
    <RootNamespace>AdvancedPBLimiter.Quasar</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Version attributes come from ..\..\Versioning\AssemblyVersion.cs (written by Versioning\version.ps1) -->
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <QuasarPluginAbstractionsProject Condition="'$(QuasarPluginAbstractionsProject)' == ''">..\..\..\quasar\Quasar.Plugin.Abstractions\Quasar.Plugin.Abstractions.csproj</QuasarPluginAbstractionsProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Versioning\AssemblyVersion.cs" Link="Properties\AssemblyVersion.cs" />
    <Compile Include="..\..\Shared\QuasarContracts.cs" Link="Contracts\QuasarContracts.cs" />
  </ItemGroup>

  <!-- Built by Quasar: the contract assembly of the running Quasar -->
  <ItemGroup Condition="'$(QuasarPluginAbstractionsAssembly)' != '' and Exists('$(QuasarPluginAbstractionsAssembly)')">
    <Reference Include="Quasar.Plugin.Abstractions">
      <HintPath>$(QuasarPluginAbstractionsAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Local builds: a quasar checkout next to this repository -->
  <ItemGroup Condition="('$(QuasarPluginAbstractionsAssembly)' == '' or !Exists('$(QuasarPluginAbstractionsAssembly)')) and Exists('$(QuasarPluginAbstractionsProject)')">
    <ProjectReference Include="$(QuasarPluginAbstractionsProject)" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="('$(QuasarPluginAbstractionsAssembly)' == '' or !Exists('$(QuasarPluginAbstractionsAssembly)')) and !Exists('$(QuasarPluginAbstractionsProject)')">
    <PackageReference Include="Quasar.Plugin.Abstractions" Version="0.1.0-preview.1" />
  </ItemGroup>

  <!-- Local testing: copy the plugin into the local Quasar install (Quasar in Directory.Build.props), laid out like a
       QuasarHub install: the manifest and DLLs in the package folder, the static assets where the manifest points.
       Quasar loads it on its next restart. Never runs when Quasar builds the plugin, it has no Quasar property. -->
  <Target Name="DeployToQuasar" AfterTargets="Build" Condition="'$(Quasar)' != '' and '$(DeployToQuasar)' != 'false'">
    <PropertyGroup>
      <_QuasarPackage>$([System.IO.Path]::Combine('$(Quasar)', 'Plugins', 'AdvancedPBLimiter'))</_QuasarPackage>
    </PropertyGroup>
    <ItemGroup>
      <_QuasarPluginFiles Include="$(OutDir)**\*.*" Exclude="$(OutDir)**\Quasar.Plugin.Abstractions.*" />
      <_QuasarStaticFiles Include="wwwroot\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="..\..\quasar-plugin.json" DestinationFolder="$(_QuasarPackage)" Retries="10" RetryDelayMilliseconds="500" />
    <Copy SourceFiles="@(_QuasarPluginFiles)" DestinationFiles="@(_QuasarPluginFiles->'$(_QuasarPackage)\%(RecursiveDir)%(Filename)%(Extension)')" Retries="10" RetryDelayMilliseconds="500" />
    <Copy SourceFiles="@(_QuasarStaticFiles)" DestinationFiles="@(_QuasarStaticFiles->'$(_QuasarPackage)\QuasarPlugin\AdvancedPBLimiter.Quasar\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" Retries="10" RetryDelayMilliseconds="500" />
    <Message Importance="high" Text="Deployed the Quasar plugin to $(_QuasarPackage), restart Quasar to load it" />
  </Target>
</Project>
