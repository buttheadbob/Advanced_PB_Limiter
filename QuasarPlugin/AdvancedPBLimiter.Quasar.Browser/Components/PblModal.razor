@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (Open)
{
    <div class="pbl-modal-backdrop" tabindex="-1" @onclick="Close" @onkeydown="OnKeyDown">
        <section @ref="_panel" class="pbl-modal @Class" role="dialog" aria-modal="true" aria-labelledby="@TitleId"
                 tabindex="-1" @onclick:stopPropagation="true" @onkeydown="OnKeyDown">
            <header class="pbl-modal-head">
                <div class="pbl-modal-title">
                    @if (!string.IsNullOrWhiteSpace(Icon))
                    {
                        <span class="pbl-modal-icon"><PblIcon Name="@Icon" /></span>
                    }
                    <div>
                        <h2 id="@TitleId">@Title</h2>
                        @if (!string.IsNullOrWhiteSpace(Subtitle))
                        {
                            <p>@Subtitle</p>
                        }
                    </div>
                </div>
                <button type="button" class="pbl-icon-btn" aria-label="Close" @onclick="Close" disabled="@Locked">
                    <PblIcon Name="x" />
                </button>
            </header>

            <div class="pbl-modal-body">@ChildContent</div>

            @if (Footer is not null)
            {
                <footer class="pbl-modal-foot">@Footer</footer>
            }
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? Class { get; set; }

    /// <summary>The dialog cannot be closed (close button, Escape, backdrop) while true: something it started is still running.</summary>
    [Parameter] public bool Locked { get; set; }

    private readonly string TitleId = "pbl-modal-title-" + Guid.NewGuid().ToString("N");
    private ElementReference _panel;
    private IJSObjectReference? _module;
    private bool _wasOpen;
    private bool _trap;    // Opened: keep Tab inside it once it has rendered, and focus it.
    private bool _release; // Closed: give focus back to where it was before it opened.

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen) _trap = true;
        if (!Open && _wasOpen) _release = true;
        _wasOpen = Open;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_trap && !_release) return;
        bool trap = _trap && Open;
        _trap = _release = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import",
                new Uri(new Uri(Navigation.BaseUri), $"_quasar/plugins/{SdkClient.PluginId}/modal.js").ToString());
            if (trap)
                await _module.InvokeVoidAsync("trap", TitleId, _panel);
            else
                await _module.InvokeVoidAsync("release", TitleId);
        }
        catch (JSException)
        {
            // Without the helper the dialog still works: it takes focus, and Escape closes it.
            if (trap) await FocusPanelAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser page is gone.
        }
    }

    private async Task FocusPanelAsync()
    {
        try
        {
            await _panel.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // The modal went away before it could take focus.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            if (_wasOpen) await _module.InvokeVoidAsync("release", TitleId);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser page is gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed.
        }
    }

    private Task Close() => Locked ? Task.CompletedTask : OnClose.InvokeAsync();

    private Task OnKeyDown(KeyboardEventArgs args) =>
        string.Equals(args.Key, "Escape", StringComparison.Ordinal) ? Close() : Task.CompletedTask;
}
