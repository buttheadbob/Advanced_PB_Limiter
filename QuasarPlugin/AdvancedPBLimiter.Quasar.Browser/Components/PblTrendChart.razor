@if (PointCount == 0)
{
    <div class="pbl-chart-empty">No snapshots yet. Leave the page live and the chart fills as data arrives.</div>
}
else
{
    <svg class="pbl-trend-chart" viewBox="0 0 @ViewWidth @ViewHeight" preserveAspectRatio="xMidYMid meet"
         role="img" aria-label="@Label">
        @((MarkupString)InnerSvg)
    </svg>

    <div class="pbl-chart-legend">
        @foreach (PblTrendSeries series in Series)
        {
            <span class="pbl-legend-item">
                <span class="pbl-legend-dot pbl-bg-@series.Tone"></span>
                @series.Label
                <strong>@FormatValue(LastValue(series))</strong>
            </span>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<PblTrendSeries> Series { get; set; } = Array.Empty<PblTrendSeries>();
    [Parameter] public string Label { get; set; } = "Session trend";
    [Parameter] public double ViewWidth { get; set; } = 720d;
    [Parameter] public double ViewHeight { get; set; } = 180d;

    private const double Left = 56d;
    private const double Right = 14d;
    private const double Top = 12d;
    private const double Bottom = 18d;

    private double PlotWidth => Math.Max(1d, ViewWidth - Left - Right);
    private double PlotHeight => Math.Max(1d, ViewHeight - Top - Bottom);

    private double MinValue { get; set; }
    private double MaxValue { get; set; } = 1d;
    private int PointCount { get; set; }
    private string InnerSvg { get; set; } = "";

    protected override void OnParametersSet()
    {
        Build();
    }

    private void Build()
    {
        PointCount = Series.Count == 0 ? 0 : Series.Max(series => series.Values.Count);
        if (PointCount == 0)
        {
            MinValue = 0d;
            MaxValue = 1d;
            InnerSvg = "";
            return;
        }

        double min = double.MaxValue;
        double max = double.MinValue;
        foreach (PblTrendSeries series in Series)
        {
            foreach (double value in series.Values)
            {
                if (!double.IsFinite(value)) continue;
                min = Math.Min(min, value);
                max = Math.Max(max, value);
            }
        }

        if (min == double.MaxValue)
        {
            min = 0d;
            max = 1d;
        }

        if (max - min < 0.0000001d)
            max = min + 1d;

        // A little headroom above the hottest point.
        max += (max - min) * 0.08d;
        MinValue = min;
        MaxValue = max;

        System.Text.StringBuilder svg = new(2048);

        for (int tick = 0; tick <= 4; tick++)
        {
            double y = Top + (PlotHeight * tick / 4d);
            svg.Append("<line x1='").Append(Number(Left))
                .Append("' y1='").Append(Number(y))
                .Append("' x2='").Append(Number(ViewWidth - Right))
                .Append("' y2='").Append(Number(y))
                .Append("' class='pbl-chart-grid'/>");

            double labelValue = MaxValue - ((MaxValue - MinValue) * tick / 4d);
            svg.Append("<text x='").Append(Number(Left - 8))
                .Append("' y='").Append(Number(y + 4))
                .Append("' text-anchor='end' class='pbl-chart-label'>")
                .Append(FormatValue(labelValue))
                .Append("</text>");
        }

        foreach (PblTrendSeries series in Series)
        {
            int count = series.Values.Count;
            svg.Append("<polyline fill='none' stroke='currentColor' class='pbl-chart-series pbl-stroke-")
                .Append(Escape(series.Tone))
                .Append("' stroke-width='2.5' vector-effect='non-scaling-stroke' stroke-linecap='round' stroke-linejoin='round' points='");

            for (int index = 0; index < count; index++)
            {
                double value = double.IsFinite(series.Values[index]) ? series.Values[index] : min;
                double x = Left + (count > 1 ? PlotWidth * index / (count - 1d) : 0d);
                double y = Top + PlotHeight - (((value - MinValue) / (MaxValue - MinValue)) * PlotHeight);
                if (index > 0) svg.Append(' ');
                svg.Append(Number(x)).Append(',').Append(Number(y));
            }

            svg.Append("'/>");

            if (count > 0)
            {
                double last = double.IsFinite(series.Values[^1]) ? series.Values[^1] : min;
                double x = Left + (count > 1 ? PlotWidth : 0d);
                double y = Top + PlotHeight - (((last - MinValue) / (MaxValue - MinValue)) * PlotHeight);
                svg.Append("<circle cx='").Append(Number(x))
                    .Append("' cy='").Append(Number(y))
                    .Append("' r='3.5' fill='currentColor' class='pbl-chart-series pbl-stroke-")
                    .Append(Escape(series.Tone))
                    .Append("'/>");
            }
        }

        InnerSvg = svg.ToString();
    }

    private static double LastValue(PblTrendSeries series) =>
        series.Values.Count == 0 ? 0d : series.Values[^1];

    private static string FormatValue(double value) =>
        value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static string Number(double value) =>
        value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private static string Escape(string value) =>
        value.Replace("'", "", StringComparison.Ordinal);
}
