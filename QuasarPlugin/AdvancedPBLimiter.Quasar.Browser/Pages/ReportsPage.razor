@page "/advanced-pb-limiter"
@attribute [Authorize(Policy = "CanView")]
@implements IDisposable
@inject IJSRuntime JS
@inject ILogger<ReportsPage> Log
@using System.Globalization

<PageTitle>PB Limiter</PageTitle>

<PageTabs Active="PageTabs.Tab.Live" Description="Live run times of every tracked programmable block. Limits are set on the server's Plugins page." />

<section class="quasar-panel pbl-toolbar">
    <label class="quasar-field">
        Server
        <select value="@_serverKey" @onchange="ServerChanged" disabled="@(_servers.Count == 0)">
            @foreach (var server in _servers)
            {
                <option value="@server.PickKey" @key="server.ServerId">@server.DisplayName</option>
            }
        </select>
    </label>
    <label class="quasar-field">
        Refresh
        <select value="@_refreshSeconds" @onchange="RefreshChanged">
            @foreach (var seconds in RefreshChoices)
            {
                <option value="@seconds">Every @seconds seconds</option>
            }
        </select>
    </label>
    <label class="quasar-field pbl-filter">
        Filter
        <input @bind="_filter" @bind:event="oninput" placeholder="@(_tab == Tab.Blocks ? "Player, grid or block" : "Player name or Steam ID")" />
    </label>
    <div class="pbl-buttons">
        <button type="button" class="quasar-button" @onclick="TogglePaused">@(_paused ? "Resume" : "Pause")</button>
        <button type="button" class="quasar-button" @onclick="RefreshNow">Refresh now</button>
    </div>
</section>

@if (_error != null)
{
    <div class="quasar-notice quasar-notice-error" role="alert">@_error</div>
}
@if (_turnOffError != null)
{
    <div class="quasar-notice quasar-notice-error" role="alert">@_turnOffError</div>
}
@if (_notice != null)
{
    <div class="quasar-notice" role="status">@_notice</div>
}

@if (_servers.Count == 0)
{
    <section class="quasar-panel pbl-message"><p>No servers are connected to Quasar right now. Servers show up here once they are running.</p></section>
}
else if (_snapshot == null)
{
    <section class="quasar-panel pbl-message"><p>Waiting for the server.</p></section>
}
else if (!_snapshot.Installed)
{
    <section class="quasar-panel pbl-message"><p>Advanced PB Limiter is not loaded on this server. Add it on the server's Plugins page.</p></section>
}
else if (!_snapshot.Online)
{
    <section class="quasar-panel pbl-message"><p>The world is still loading.</p></section>
}
else
{
    <section class="quasar-panel pbl-summary">
        <span>Version @_snapshot.Version</span>
        <span>@InvariantText.Count(_snapshot.Players.Count, "player", "players")</span>
        <span>@InvariantText.Count(_snapshot.Players.Sum(p => p.BlockCount), "block", "blocks") tracked</span>
        <span>@InvariantText.Count(_snapshot.Players.Sum(p => p.Offences), "offence", "offences")</span>
        @if (!_snapshot.Enabled)
        {
            <span class="pbl-warning">The limiter is disabled on this server</span>
        }
        @if (_snapshot.Truncated)
        {
            <span class="pbl-warning">Showing the first @_snapshot.Blocks.Count blocks</span>
        }
    </section>

    <div class="pbl-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="@(_tab == Tab.Blocks)" class="quasar-button @(_tab == Tab.Blocks ? "quasar-button-primary" : "")" @onclick="() => SelectTab(Tab.Blocks)">Programmable blocks</button>
        <button type="button" role="tab" aria-selected="@(_tab == Tab.Players)" class="quasar-button @(_tab == Tab.Players ? "quasar-button-primary" : "")" @onclick="() => SelectTab(Tab.Players)">Players</button>
    </div>

    <section class="quasar-panel pbl-table-panel">
        @if (_tab == Tab.Blocks)
        {
            var rows = SortedBlocks();
            @if (rows.Count == 0)
            {
                <p class="pbl-message">@(Filtering ? (_snapshot.Truncated ? "No programmable blocks among those shown match the filter." : "No programmable blocks match the filter.") : "No programmable blocks to show. A block is tracked from its first run.")</p>
            }
            else
            {
                <div class="quasar-table-scroll">
                    <table class="pbl-table">
                        <thead>
                            <tr>
                                @Header("Block", nameof(BlockRowView.BlockName))
                                @Header("Grid", nameof(BlockRowView.GridName))
                                @Header("Owner", nameof(BlockRowView.OwnerName))
                                @Header("Last ms", nameof(BlockRowView.LastRunTimeMS))
                                @Header("Average ms", nameof(BlockRowView.RunTimeMSAvg))
                                @Header("Peak ms", nameof(BlockRowView.PeekRunTimeMS))
                                @Header("Offences", nameof(BlockRowView.Offences))
                                @Header("Recompiles", nameof(BlockRowView.Recompiles))
                                @Header("Memory", nameof(BlockRowView.MemoryBytes))
                                <th scope="col">State</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                var key = $"block:{row.EntityId}";
                                <tr @key="row.EntityId">
                                    <td>
                                        @row.BlockName
                                        @if (row.Resting)
                                        {
                                            <span class="pbl-tag" title="Not run lately: its run times may be as old as the server keeps player data (60 minutes by default) and are left out of the combined run times.">resting</span>
                                        }
                                    </td>
                                    <td>@row.GridName</td>
                                    <td>@row.OwnerName</td>
                                    <td class="pbl-number">@Figures.Ms(row.LastRunTimeMS)</td>
                                    <td class="pbl-number">@Figures.Ms(row.RunTimeMSAvg)</td>
                                    <td class="pbl-number">@Figures.Ms(row.PeekRunTimeMS)</td>
                                    <td class="pbl-number">@row.Offences</td>
                                    <td class="pbl-number">@row.Recompiles</td>
                                    <td class="pbl-number" title="@(row.MemoryUnmeasured ? MemoryUnmeasuredTip : null)">@Figures.Memory(row.MemoryBytes, row.MemoryUnmeasured)</td>
                                    <td>
                                        @if (!row.Enabled)
                                        {
                                            <span>Off</span>
                                        }
                                        else if (_canControl)
                                        {
                                            @TurnOffButton(key, row.BlockName, () => TurnOffBlockAsync(row))
                                        }
                                        else
                                        {
                                            <span>On</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            var rows = SortedPlayers();
            @if (rows.Count == 0)
            {
                <p class="pbl-message">@(Filtering ? "No players match the filter." : "No players to show. A player is tracked from the first run of one of their blocks.")</p>
            }
            else
            {
                <div class="quasar-table-scroll">
                    <table class="pbl-table">
                        <thead>
                            <tr>
                                @Header("Player", nameof(PlayerRowView.Name))
                                @Header("Steam ID", nameof(PlayerRowView.SteamId))
                                @Header("Blocks", nameof(PlayerRowView.BlockCount))
                                @Header("Combined ms", nameof(PlayerRowView.CombinedLastRunTimeMS))
                                @Header("Combined average ms", nameof(PlayerRowView.CombinedRunTimeMSAvg))
                                @Header("Offences", nameof(PlayerRowView.Offences))
                                @Header("Recompiles", nameof(PlayerRowView.Recompiles))
                                @Header("Memory", nameof(PlayerRowView.MemoryBytes))
                                @if (_canControl)
                                {
                                    <th scope="col">All blocks</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                var key = $"player:{row.IdentityId}";
                                <tr @key="row.IdentityId">
                                    <td>
                                        @row.Name
                                        @if (row.IsNpc)
                                        {
                                            <span class="pbl-tag">NPC</span>
                                        }
                                        @if (row.IsPrivileged)
                                        {
                                            <span class="pbl-tag">Privileged</span>
                                        }
                                    </td>
                                    <td class="pbl-number">@(row.IsNpc ? "" : row.SteamId)</td>
                                    <td class="pbl-number">@row.BlockCount</td>
                                    <td class="pbl-number">@Figures.Ms(row.CombinedLastRunTimeMS)</td>
                                    <td class="pbl-number">@Figures.Ms(row.CombinedRunTimeMSAvg)</td>
                                    <td class="pbl-number">@row.Offences</td>
                                    <td class="pbl-number">@row.Recompiles</td>
                                    <td class="pbl-number" title="@(row.MemoryUnmeasured ? PlayerMemoryUnmeasuredTip : null)">@Figures.MemoryTotal(row.MemoryBytes, row.MemoryUnmeasured)</td>
                                    @if (_canControl)
                                    {
                                        <td>@TurnOffButton(key, $"all of {row.Name}'s blocks", () => TurnOffPlayerAsync(row))</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
}

@code {
    private enum Tab { Blocks, Players }

    private static readonly int[] RefreshChoices = { 2, 5, 10, 30 };

    // Their headers line up with their right aligned cells.
    private static readonly HashSet<string> NumericColumns = new()
    {
        nameof(BlockRowView.LastRunTimeMS), nameof(BlockRowView.RunTimeMSAvg), nameof(BlockRowView.PeekRunTimeMS), nameof(BlockRowView.Offences),
        nameof(BlockRowView.Recompiles), nameof(BlockRowView.MemoryBytes), nameof(PlayerRowView.SteamId), nameof(PlayerRowView.BlockCount),
        nameof(PlayerRowView.CombinedLastRunTimeMS), nameof(PlayerRowView.CombinedRunTimeMSAvg)
    };

    private static readonly TimeSpan RequestTimeout = TimeSpan.FromSeconds(10);

    private readonly PageClosing _closing = new();

    private readonly SemaphoreSlim _wake = new(0, 1);

    private IReadOnlyList<ServerInfo> _servers = Array.Empty<ServerInfo>();
    private string? _serverKey;
    private string? _serverId;
    private ReportSnapshotView? _snapshot;
    private string? _error;
    // A turn-off whose outcome is not known. Kept until the next turn-off or a server switch, as refreshes do not answer it.
    private string? _turnOffError;
    // "Refresh now" pressed: the next pass refreshes even while paused.
    private bool _refreshOnce;
    private string? _notice;
    private string _filter = "";
    private int _refreshSeconds = 5;
    private bool _paused;
    private bool _canControl;
    private Tab _tab = Tab.Blocks;
    private string _sortColumn = nameof(BlockRowView.LastRunTimeMS);
    private bool _sortDescending = true;
    private string? _confirming;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshServersAsync(_closing.Token);
        }
        catch (Exception e)
        {
            _error = "Could not read the server list: " + e.Message;
        }

        _serverId = _servers.FirstOrDefault()?.ServerId;
        try
        {
            _canControl = await CanControlAsync();
        }
        catch
        {
            _canControl = false;
        }
    }

    private async Task RefreshServersAsync(CancellationToken closing)
    {
        ServerListResponse response = await SdkClient.RequestAsync<ServerListResponse>(JS, UiOperations.Servers, new EmptyPayload(), closing);
        _servers = response.Servers.Where(s => s.Connected).ToList();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // After the first interactive render, so a prerender never starts polling.
        if (firstRender)
            _ = PollAsync();
    }

    private async Task PollAsync()
    {
        CancellationToken closing = _closing.Token;
        try
        {
            while (!closing.IsCancellationRequested)
            {
                if (!_paused || _refreshOnce)
                {
                    _refreshOnce = false;
                    await RefreshAsync(closing);
                }

                await _wake.WaitAsync(TimeSpan.FromSeconds(_refreshSeconds), closing);
            }
        }
        catch (OperationCanceledException) when (closing.IsCancellationRequested)
        {
            // The page closed.
        }
    }

    private async Task RefreshAsync(CancellationToken closing)
    {
        try
        {
            await RefreshServersAsync(closing);
        }
        catch (OperationCanceledException) when (closing.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception e)
        {
            if (_serverId is not null && PageShared.ReportReadFailures.IsNew("servers", e.Message))
                Log.LogWarning(e, "Could not read the PB Limiter server list");
        }

        string? previousServerId = _serverId;
        if (_servers.All(s => s.PickKey != _serverKey))
            _serverKey = _servers.FirstOrDefault()?.PickKey;
        _serverId = _servers.FirstOrDefault(s => s.PickKey == _serverKey)?.ServerId;
        if (_serverId != previousServerId)
        {
            _snapshot = null;
            _error = null;
            _notice = null;
            _turnOffError = null;
            _confirming = null;
        }

        string? serverId = _serverId;
        if (serverId == null)
        {
            _error = null;
            _snapshot = null;
            await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));
            return;
        }

        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(closing);
        timeout.CancelAfter(RequestTimeout);
        try
        {
            ReportSnapshotView snapshot = await SdkClient.RequestAsync<ReportSnapshotView>(JS, UiOperations.Snapshot,
                new ReadSnapshotRequest { ServerId = serverId }, timeout.Token);
            if (serverId != _serverId) return; // The server was changed while this was on its way.
            _snapshot = snapshot;
            _error = null;
        }
        catch (OperationCanceledException) when (closing.IsCancellationRequested)
        {
            throw;
        }
        catch (OperationCanceledException)
        {
            if (serverId == _serverId) // Not after a switch to another server.
                _error = "The server did not answer in time.";
        }
        catch (Exception e)
        {
            // The page refreshes every few seconds: each reason is logged once, not on every refresh.
            if (PageShared.ReportReadFailures.IsNew(serverId, e.Message))
                Log.LogWarning(e, "Could not read the PB Limiter report of {Server}", ServerName(serverId));
            if (serverId == _serverId)
                _error = "Could not read the report: " + e.Message + CompanionErrors.RestartHint(e);
        }

        await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));
    }

    /// <summary>Refreshes once now, also while paused.</summary>
    private void RefreshNow()
    {
        _refreshOnce = true;
        Wake();
    }

    private void Wake() => Signals.Wake(_wake);

    /// <summary>The server's name for the log, as the other pages log it; its id when it is no longer listed.</summary>
    private string ServerName(string serverId) => _servers.FirstOrDefault(s => s.ServerId == serverId)?.DisplayName ?? serverId;

    private void ServerChanged(ChangeEventArgs e)
    {
        _serverKey = e.Value?.ToString();
        _serverId = _servers.FirstOrDefault(s => s.PickKey == _serverKey)?.ServerId;
        _snapshot = null;
        _confirming = null;
        _notice = null;
        _error = null;
        _turnOffError = null;
        _refreshOnce = true; // Also while paused: the page shows nothing for the new server until it refreshes.
        Wake();
    }

    private void RefreshChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int seconds) && RefreshChoices.Contains(seconds))
        {
            _refreshSeconds = seconds;
            Wake();
        }
    }

    private void TogglePaused()
    {
        _paused = !_paused;
        Wake();
    }

    private Task<bool> CanControlAsync()
    {
        return SdkClient.AllowedAsync(JS, "CanControlServers", _closing.Token);
    }


    private Task TurnOffBlockAsync(BlockRowView row)
    {
        return RunTurnOffAsync($"{row.BlockName} on {row.GridName}",
            (serverId, token) => SdkClient.RequestAsync<TurnOffResult>(JS, UiOperations.TurnOffBlock,
                new TurnOffBlockUiRequest { ServerId = serverId, EntityId = row.EntityId }, token));
    }

    private Task TurnOffPlayerAsync(PlayerRowView row)
    {
        return RunTurnOffAsync($"all of {row.Name}'s blocks",
            (serverId, token) => SdkClient.RequestAsync<TurnOffResult>(JS, UiOperations.TurnOffPlayer,
                new TurnOffPlayerUiRequest { ServerId = serverId, IdentityId = row.IdentityId }, token));
    }

    private async Task RunTurnOffAsync(string what, Func<string, CancellationToken, Task<TurnOffResult>> turnOff)
    {
        _confirming = null;
        _notice = null;
        _turnOffError = null;

        // The button is hidden without this right, but a hidden button is not access control.
        bool canControl;
        try
        {
            canControl = await CanControlAsync();
        }
        catch (Exception e)
        {
            _turnOffError = "Could not check your permission: " + e.Message;
            return;
        }
        if (!canControl)
        {
            _turnOffError = "You do not have permission to control servers.";
            return;
        }

        string? serverId = _serverId;
        if (serverId == null) return;
        // Taken now: the server may have left the list by the time it answers, a disconnect being the usual failure.
        string serverName = ServerName(serverId);

        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(_closing.Token);
        timeout.CancelAfter(RequestTimeout);
        try
        {
            TurnOffResult result = await turnOff(serverId, timeout.Token);
            Log.LogInformation("Turned off {What} on {Server}, {Count}", what, serverName, InvariantText.Count(result.TurnedOff, "block", "blocks"));
            if (serverId != _serverId) return; // The server was changed while this was on its way.
            _notice = result.TurnedOff == 0
                ? $"Nothing to turn off for {what}: already off, or no longer tracked."
                : $"Turned off {what}: {InvariantText.Count(result.TurnedOff, "block", "blocks")}.";
            _error = null;
            Wake();
        }
        catch (OperationCanceledException) when (_closing.IsClosed)
        {
            // The page closed.
        }
        catch (OperationCanceledException)
        {
            // The 1.3.3 companion does not start it after the deadline it carries, as far as the two clocks agree, and one it
            // started in time can finish after this stopped waiting.
            if (serverId == _serverId)
                _turnOffError = $"The server did not answer in time, so it may or may not have turned off {what}. Check the report to see which.";
            Wake();
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not turn off {What} on {Server}", what, serverName);
            // The request may have reached the server before this failed, the agent disconnecting before it answered say.
            if (serverId == _serverId)
                _turnOffError = $"Could not confirm the result of turning off {what}: {e.Message.TrimEnd('.')}. Check the report to see what is off.";
            Wake();
        }
    }

    private RenderFragment TurnOffButton(string key, string what, Func<Task> confirmed) => __builder =>
    {
        if (_confirming == key)
        {
            // Rows move as they re-sort, so this says what it is about to do rather than relying on where it sits.
            <span class="pbl-confirm">Turn off @what?</span>
            <button type="button" class="quasar-button quasar-button-primary" @onclick="confirmed">Confirm</button>
            <button type="button" class="quasar-button" @onclick="() => _confirming = null">Cancel</button>
        }
        else
        {
            <button type="button" class="quasar-button" @onclick="() => _confirming = key">Turn off</button>
        }
    };

    private RenderFragment Header(string title, string column) => __builder =>
    {
        <th scope="col" class="@(NumericColumns.Contains(column) ? "pbl-number" : "")" aria-sort="@(_sortColumn == column ? (_sortDescending ? "descending" : "ascending") : "none")">
            <button type="button" class="pbl-sort" @onclick="() => SortBy(column)">
                @title @(_sortColumn == column ? (_sortDescending ? "▼" : "▲") : "")
            </button>
        </th>
    };

    /// <summary>Shows a tab sorted the way it opens, its run time highest first, as its own columns show.</summary>
    private void SelectTab(Tab tab)
    {
        if (_tab == tab) return;
        _tab = tab;
        _sortColumn = tab == Tab.Blocks ? nameof(BlockRowView.LastRunTimeMS) : nameof(PlayerRowView.CombinedLastRunTimeMS);
        _sortDescending = true;
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortDescending = !_sortDescending;
            return;
        }

        _sortColumn = column;
        _sortDescending = true;
    }

    private bool Filtering => !string.IsNullOrWhiteSpace(_filter);

    private const string MemoryUnmeasuredTip = "The memory check could not measure this script: its structs nest too deep, one of its types can't be loaded, or, with a memory limit set, it holds more than the check can follow. The server log says which. With a memory limit set it counts as over it.";
    private const string PlayerMemoryUnmeasuredTip = "At least one of this player's scripts could not be measured by the memory check; any figure shown is the memory of the scripts that could be. With a memory limit set, such a script counts as over it.";

    // A block or player that could not be measured sorts above every measured one.
    private static long MemorySortKey(long bytes, bool unmeasured) => unmeasured ? long.MaxValue : bytes;

    private bool Matches(params string[] values)
    {
        return !Filtering || values.Any(v => v.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase));
    }

    private List<BlockRowView> SortedBlocks()
    {
        IEnumerable<BlockRowView> rows = _snapshot!.Blocks.Where(b => Matches(b.BlockName, b.GridName, b.OwnerName));
        return Sorted(rows, _sortColumn switch
        {
            nameof(BlockRowView.BlockName) => b => b.BlockName,
            nameof(BlockRowView.GridName) => b => b.GridName,
            nameof(BlockRowView.OwnerName) => b => b.OwnerName,
            nameof(BlockRowView.RunTimeMSAvg) => b => b.RunTimeMSAvg,
            nameof(BlockRowView.PeekRunTimeMS) => b => b.PeekRunTimeMS,
            nameof(BlockRowView.Offences) => b => b.Offences,
            nameof(BlockRowView.Recompiles) => b => b.Recompiles,
            nameof(BlockRowView.MemoryBytes) => b => MemorySortKey(b.MemoryBytes, b.MemoryUnmeasured),
            _ => b => b.LastRunTimeMS
        });
    }

    private List<PlayerRowView> SortedPlayers()
    {
        IEnumerable<PlayerRowView> rows = _snapshot!.Players.Where(p => Matches(p.Name, p.SteamId));
        return Sorted(rows, _sortColumn switch
        {
            nameof(PlayerRowView.Name) => p => p.Name,
            nameof(PlayerRowView.SteamId) => p => ulong.TryParse(p.SteamId, NumberStyles.Integer, CultureInfo.InvariantCulture, out ulong id) ? id : 0UL,
            nameof(PlayerRowView.BlockCount) => p => p.BlockCount,
            nameof(PlayerRowView.CombinedRunTimeMSAvg) => p => p.CombinedRunTimeMSAvg,
            nameof(PlayerRowView.Offences) => p => p.Offences,
            nameof(PlayerRowView.Recompiles) => p => p.Recompiles,
            nameof(PlayerRowView.MemoryBytes) => p => MemorySortKey(p.MemoryBytes, p.MemoryUnmeasured),
            _ => p => p.CombinedLastRunTimeMS
        });
    }

    // Names ignoring case, the same on every host whatever its culture; numbers as they are.
    private static readonly IComparer<IComparable> SameEverywhere = Comparer<IComparable>.Create(
        (x, y) => x is string a && y is string b ? StringComparer.OrdinalIgnoreCase.Compare(a, b) : Comparer<IComparable>.Default.Compare(x, y));

    private List<T> Sorted<T>(IEnumerable<T> rows, Func<T, IComparable> key)
    {
        return (_sortDescending ? rows.OrderByDescending(key, SameEverywhere) : rows.OrderBy(key, SameEverywhere)).ToList();
    }

    public void Dispose()
    {
        _closing.Dispose();
    }
}
