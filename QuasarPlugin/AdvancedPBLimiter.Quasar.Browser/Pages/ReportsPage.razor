@page "/advanced-pb-limiter"
@attribute [Authorize(Policy = "CanView")]
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<ReportsPage> Log
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@using AdvancedPBLimiter.Quasar.Components.Live

<PageTitle>PB Limiter · Live</PageTitle>

<PageTabs Active="PageTabs.Tab.Live" Description="Live run times of every tracked programmable block. Limits are set on the server's Plugins page.">
    <div class="pbl-commandbar">
        <div class="pbl-commandbar-main">
            @if (_servers.Count > 0)
            {
                <label class="pbl-field pbl-field-server">
                    <span>Server</span>
                    <select value="@_serverKey" @onchange="ServerChanged" disabled="@_turnOffBusy">
                        @foreach (ServerInfo server in _servers)
                        {
                            <option value="@server.PickKey" disabled="@(!server.Connected)">@server.DisplayName@(server.Connected ? "" : " (offline)")</option>
                        }
                    </select>
                </label>
            }

            <div class="pbl-live-state">
                <span class="pbl-live-dot @(_paused ? "paused" : _stale ? "stale" : "live")"></span>
                <span>@(_paused ? "Paused" : _stale ? "Not responding" : "Live")</span>
                @if (_paused && _pausedAtUtc is { } pausedAt)
                {
                    <span class="pbl-muted">· at @pausedAt.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture)</span>
                }
                else if (_lastUpdatedUtc is { } updated)
                {
                    <span class="pbl-muted">· @(_stale ? "last data" : "updated") @TimeText.Ago(updated)</span>
                }
            </div>
        </div>

        <div class="pbl-commandbar-actions">
            <label class="pbl-field pbl-field-compact">
                <span>Update every</span>
                <select value="@_refreshSeconds" @onchange="RefreshChanged">
                    @foreach (int seconds in RefreshChoices)
                    {
                        <option value="@seconds">@seconds s</option>
                    }
                </select>
            </label>

            <button type="button" class="pbl-btn" @onclick="TogglePaused">
                <PblIcon Name="@(_paused ? "play" : "pause")" />
                @(_paused ? "Resume" : "Pause")
            </button>

            <button type="button" class="pbl-btn" @onclick="RefreshNow" disabled="@_refreshing">
                <PblIcon Name="refresh" Class="@(_refreshing ? "pbl-spin" : null)" />
                Refresh
            </button>

            <button type="button" class="pbl-btn" @onclick="DownloadCsvAsync" disabled="@(_snapshot is null)" title="Every block in the report, whatever the table is filtered by">
                <PblIcon Name="download" />
                Export blocks (CSV)
            </button>
        </div>
    </div>

    <div class="pbl-progress-slot">
        @if (_refreshing && _snapshot is not null)
        {
            <PblProgress Indeterminate="true" Label="Refreshing report" />
        }
    </div>

    @if (_error is not null && !(_stale && _snapshot is not null))
    {
        <PblNotice Tone="danger" Icon="alert" Dismiss="ClearError">@_error</PblNotice>
    }
    @if (_controlCheckSlow)
    {
        <PblNotice Tone="info" Icon="clock">Still checking your permission to turn blocks off. If you may, the Turn off buttons appear once Quasar answers.</PblNotice>
    }
    @if (_controlCheckError is not null)
    {
        <PblNotice Tone="warning" Icon="alert" Dismiss="ClearControlCheckError">@_controlCheckError</PblNotice>
    }
    @if (_turnOffError is not null)
    {
        <PblNotice Tone="danger" Icon="alert" Dismiss="ClearTurnOffError">@_turnOffError</PblNotice>
    }
    @if (_notice is not null)
    {
        <PblNotice Tone="success" Icon="check" Dismiss="ClearNotice">@_notice</PblNotice>
    }
    @if (_snapshot is not null && _stale)
    {
        <PblNotice Tone="warning" Icon="wifi-off">
            @_error Showing the last data received @(_lastUpdatedUtc is { } at ? TimeText.Ago(at) : "earlier").
            <button type="button" class="pbl-btn pbl-btn-small" @onclick="RefreshNow">Try again</button>
        </PblNotice>
    }
    @if (_snapshot is { Enabled: false })
    {
        <PblNotice Tone="warning" Icon="alert">The limiter is disabled on this server. Nothing new is tracked or punished while it is off.</PblNotice>
    }
    @if (_snapshot is { Truncated: true })
    {
        <PblNotice Tone="warning" Icon="info">Listing @_live.ListedBlocks of @_live.TotalBlocks blocks: a report carries no more. The totals count all @_live.TotalBlocks.</PblNotice>
    }

    @if (!_serversLoaded)
    {
        <div class="pbl-card">
            <div class="pbl-card-body"><PblSkeleton Rows="5" /></div>
        </div>
    }
    else if (_servers.Count == 0 && _serversFailed)
    {
        <PblEmptyState Icon="wifi-off" Title="Could not read the server list" Description="Quasar did not answer. Try again in a moment.">
            <button type="button" class="pbl-btn pbl-btn-primary" @onclick="RefreshNow">
                <PblIcon Name="refresh" /> Try again
            </button>
        </PblEmptyState>
    }
    else if (_servers.Count == 0)
    {
        <PblEmptyState Icon="server" Title="No servers connected" Description="Servers show up here once they are running and connected to Quasar.">
            <button type="button" class="pbl-btn pbl-btn-primary" @onclick="RefreshNow">
                <PblIcon Name="refresh" /> Refresh
            </button>
        </PblEmptyState>
    }
    else if (_serverId is null)
    {
        <PblEmptyState Icon="server" Title="Choose a server" Description="Pick a connected server above to see its live report." />
    }
    else if (SelectedServer is { Connected: false } offline)
    {
        <PblEmptyState Icon="wifi-off" Title="@(offline.DisplayName + " is offline")"
                       Description="@(offline.LastSeenUtc > DateTime.MinValue ? $"Last seen {TimeText.Ago(offline.LastSeenUtc)}. Pick a connected server above." : "Pick a connected server above.")" />
    }
    else if (_snapshot is null)
    {
        @if (_error is null)
        {
            <div class="pbl-card">
                <div class="pbl-card-body"><PblSkeleton Rows="5" /></div>
            </div>
        }
        else
        {
            <PblEmptyState Icon="wifi-off" Title="No data yet" Description="The server has not answered yet. It may still be loading." />
        }
    }
    else if (!_snapshot.Installed)
    {
        <PblEmptyState Icon="server" Title="Advanced PB Limiter is not loaded" Description="Add the plugin on the server's Plugins page, then try again." />
    }
    else if (_snapshot.Inactive is { Length: > 0 } inactive)
    {
        <PblEmptyState Icon="power" Title="Advanced PB Limiter is inactive on this server" Description="@inactive" />
    }
    else if (!_snapshot.Online)
    {
        <PblEmptyState Icon="clock" Title="The world is still loading" Description="The report will appear as soon as the server is ready." />
    }
    else
    {
        <div class="pbl-stat-grid">
            <PblStat Label="Players" Value="@InvariantText.Of(_live.TotalPlayers)" Icon="users" Hint="Tracked identities"
                     Sparkline="@_live.History.Players" />
            <PblStat Label="Blocks" Value="@InvariantText.Of(_live.TotalBlocks)" Icon="cube" Hint="Tracked programmable blocks"
                     Sparkline="@_live.History.Blocks" />
            <PblStat Label="Resting" Value="@InvariantText.Of(_live.RestingCount)" Icon="clock" Hint="Not run lately"
                     Tone="@(_live.RestingCount > 0 ? "info" : "neutral")" />
            <PblStat Label="Total last" Value="@(Figures.Time(_live.CombinedLast) + " ms")" Icon="activity" Hint="All counted blocks; a spike counts as its block's average"
                     Sparkline="@_live.History.CombinedLast" />
            <PblStat Label="Total average" Value="@(Figures.Time(_live.CombinedAverage) + " ms")" Icon="zap" Hint="Sum of the blocks' averages"
                     Tone="info" Sparkline="@_live.History.CombinedAverage" />
            <PblStat Label="Offences" Value="@InvariantText.Of(_live.TotalOffences)" Icon="shield"
                     Hint="Recent offences still counted" Tone="@(_live.TotalOffences > 0 ? "warning" : "neutral")"
                     Sparkline="@_live.History.Offences" />
            <PblStat Label="Recompiles" Value="@InvariantText.Of(_live.TotalRecompiles)" Icon="refresh"
                     Hint="Since tracking started" Sparkline="@_live.History.Recompiles" />
            <PblStat Label="Memory" Value="@MemoryValue" Icon="memory" Hint="@MemoryHint"
                     Sparkline="@_live.History.Memory" />
        </div>

        <PblTabs Tabs="Tabs" ActiveKey="@_live.TabKey" ActiveKeyChanged="TabChanged" Label="Live view" />

        <div role="tabpanel" id="pbl-live-panel" aria-labelledby="@PblTabs.TabId(_live.TabKey)">
        @if (_live.Tab == LiveTab.Overview)
        {
            <div class="pbl-overview-grid">
                <PblCard Title="Hottest blocks" Subtitle="By average run time, the whole server" Class="pbl-span-2">
                    @if (_live.TopBlocks.Count == 0)
                    {
                        <PblEmptyState Icon="cube" Title="No blocks yet" Description="A block is tracked from its first run." />
                    }
                    else
                    {
                        <div class="pbl-rank-list">
                            @for (int index = 0; index < _live.TopBlocks.Count; index++)
                            {
                                BlockRowView row = _live.TopBlocks[index];
                                BlockHistoryRowView? history = _history.GetValueOrDefault(row.EntityId);
                                <button type="button" class="pbl-rank-row" @onclick="() => ShowBlock(row)">
                                    <span class="pbl-rank">@(index + 1)</span>
                                    <span class="pbl-rank-main">
                                        <strong>@row.BlockName</strong>
                                        <small>@row.GridName · @row.OwnerName</small>
                                    </span>
                                    <span class="pbl-rank-spark">
                                        @if (history is { RunTimesMS.Count: > 1 })
                                        {
                                            <PblSparkline Values="@history.RunTimesMS" Tone="@BlockTable.RunsTone(history)" Label="@($"Last run times of {row.BlockName}")"
                                                          ViewWidth="96" ViewHeight="24" />
                                        }
                                    </span>
                                    <span class="pbl-rank-value">@Figures.Time(row.RunTimeMSAvg) <small>ms avg</small></span>
                                    <span class="pbl-bar"><span style="width: @BarPercent(row.RunTimeMSAvg, _live.MaxBlockAverage)%"></span></span>
                                </button>
                            }
                        </div>
                    }
                </PblCard>

                <PblCard Title="Players at a glance" Subtitle="By total average run time">
                    @if (_live.TopPlayers.Count == 0)
                    {
                        <PblEmptyState Icon="users" Title="No players yet" Description="A player appears from the first run of one of their blocks." />
                    }
                    else
                    {
                        @foreach (PlayerRowView row in _live.TopPlayers)
                        {
                            <button type="button" class="pbl-player-mini" @key="row.IdentityId" @onclick="() => ShowPlayer(row)">
                                <span class="pbl-avatar pbl-avatar-@AvatarIndex(row.Name)">@Initials(row.Name)</span>
                                <span class="pbl-player-mini-main">
                                    <strong>@row.Name</strong>
                                    <small>@InvariantText.Count(row.BlockCount, "block", "blocks") · @InvariantText.Count(row.Offences, "offence", "offences")</small>
                                </span>
                                <span class="pbl-player-mini-value">@Figures.Time(row.CombinedRunTimeMSAvg) <small>ms avg</small></span>
                            </button>
                        }
                    }
                </PblCard>

                <PblCard Title="Session trend" Subtitle="Total run times, collected in this browser tab since it opened" Class="pbl-span-3">
                    @if (_sessionChart is { X.Count: > 1 })
                    {
                        <PblChart Spec="_sessionChart" />
                    }
                    else
                    {
                        <div class="pbl-chart-empty">The chart fills as data arrives. Leave the page live.</div>
                    }
                </PblCard>
            </div>
        }
        else
        {
            <div class="pbl-filterbar">
                <label class="pbl-search">
                    <PblIcon Name="search" />
                    <input type="search" placeholder="@(_live.Tab == LiveTab.Blocks ? "Filter by player, grid or block" : "Filter by player name or Steam ID")"
                           aria-label="@(_live.Tab == LiveTab.Blocks ? "Filter blocks" : "Filter players")"
                           value="@_live.Filter" @oninput="FilterChanged" />
                </label>

                @if (_live.Tab == LiveTab.Blocks)
                {
                    <div class="pbl-chips">
                        @foreach (PblStateChip chip in StateChips)
                        {
                            <button type="button" class="pbl-chip @(_live.StateFilter == chip.Filter ? "active" : "")"
                                    aria-pressed="@(_live.StateFilter == chip.Filter ? "true" : "false")"
                                    @onclick="() => StateFilterChanged(chip.Filter)">
                                @chip.Label <span class="pbl-chip-count">@chip.Count</span>
                            </button>
                        }
                    </div>
                }

                @if (_live.Tab == LiveTab.Blocks && _live.OwnerFilterId is not null)
                {
                    <button type="button" class="pbl-chip active" @onclick="ClearOwnerFilter" title="Show every player's blocks">
                        Owner: @_live.OwnerFilterName <PblIcon Name="x" />
                    </button>
                }

                @if (_live.Filtering)
                {
                    <button type="button" class="pbl-btn pbl-btn-ghost pbl-btn-small" @onclick="ClearFilters">Clear filters</button>
                }
            </div>

            @if (_live.Tab == LiveTab.Blocks)
            {
                <PblCard Title="Programmable blocks" Subtitle="@TableSubtitle(_live.BlockMatches, _live.TotalBlocks)">
                    <BlockTable Rows="@_live.PageBlocks" History="_history" Filtered="@_live.Filtering"
                                SortColumn="@_live.SortColumn" SortDescending="@_live.SortDescending"
                                CanControl="@_canControl" Sort="SortBy" Details="ShowBlock" TurnOff="AskTurnOffBlock" Hover="HoldOrder"
                                ClearFilter="ClearFilters" />
                    <PblPagination Total="@_live.BlockMatches" Page="@_live.BlockPage" PageSize="@_live.PageSize"
                                    PageChanged="BlockPageChanged" PageSizeChanged="PageSizeChanged" />
                </PblCard>
            }
            else
            {
                <PblCard Title="Players" Subtitle="@TableSubtitle(_live.PlayerMatches, _live.TotalPlayers)">
                    <PlayerTable Rows="@_live.PagePlayers" Filtered="@_live.Filtering"
                                 SortColumn="@_live.SortColumn" SortDescending="@_live.SortDescending"
                                 CanControl="@_canControl" Sort="SortBy" Details="ShowPlayer" TurnOff="AskTurnOffPlayer" Hover="HoldOrder"
                                 PlayersWithBlocksOn="@_live.PlayersWithBlocksOn" AnyMayHaveBlocksOn="@_live.AnyPlayerMayHaveBlocksOn"
                                 ClearFilter="ClearFilters" />
                    <PblPagination Total="@_live.PlayerMatches" Page="@_live.PlayerPage" PageSize="@_live.PageSize"
                                    PageChanged="PlayerPageChanged" PageSizeChanged="PageSizeChanged" />
                </PblCard>
            }
        }
        </div>
    }

    <PblModal Open="_selectedBlock is not null" Title="@(_selectedBlock?.BlockName ?? "Block")"
              Subtitle="@BlockSubtitle" Icon="cube" OnClose="CloseDetails" Class="pbl-modal-wide">
        @if (_selectedBlock is { } block)
        {
            BlockHistoryRowView? history = _history.GetValueOrDefault(block.EntityId);
            <section class="pbl-history" aria-label="Run history">
                <div class="pbl-history-head">
                    <h3>@(history is { RunTimesMS.Count: > 0 } ? $"Last {history.RunTimesMS.Count} runs" : "Last runs")</h3>
                    <span class="pbl-muted">Updates with the page. Click a legend item to hide it.</span>
                </div>
                @if (_blockChart is not null && history is not null)
                {
                    <PblChart Spec="_blockChart" />
                    <ul class="pbl-history-facts">
                        <li>
                            Average <strong>@Figures.Time(history.AverageMS) ms</strong>
                            @(history.AverageLimitMS > 0 ? $"of the {Figures.Time(history.AverageLimitMS)} ms limit" : "with no average limit")
                            @if (history.LeftOutOfAverage.Count > 0)
                            {
                                <span class="pbl-muted">&nbsp;· @LeftOutText(history)</span>
                            }
                        </li>
                        @{
                            int forgiven = ChartSpecs.CountOutcome(history, RunOutcome.Forgiven);
                            int counted = ChartSpecs.CountOutcome(history, RunOutcome.Counted);
                            int notChecked = ChartSpecs.CountOutcome(history, RunOutcome.NotChecked);
                            int stoodOut = ChartSpecs.CountOutcome(history, RunOutcome.StoodOut);
                            int instantKilled = ChartSpecs.CountOutcome(history, RunOutcome.InstantKilled);
                        }
                        @if (forgiven + counted + notChecked > 0 || history.RunTimeLimitMS > 0)
                        {
                            <li>
                                <strong>@(forgiven + counted + notChecked)</strong> of @history.RunTimesMS.Count runs over the run-time limit when they came@(instantKilled > 0 ? ", besides the instant kill" : "")
                                <span class="pbl-muted">@OutcomeText(forgiven, counted, notChecked)</span>
                            </li>
                        }
                        @if (stoodOut > 0)
                        {
                            <li>@InvariantText.Count(stoodOut, "run", "runs") stood out as @(stoodOut == 1 ? "a spike" : "spikes") with no run-time limit</li>
                        }
                        @if (instantKilled > 0)
                        {
                            <li>@InvariantText.Count(instantKilled, "run was", "runs were") the instant kill</li>
                        }
                        <li>@InstantKillText(history)</li>
                    </ul>
                }
                else if (history is { RunTimesMS.Count: 0 })
                {
                    <div class="pbl-chart-empty">No runs since the block was last recompiled.</div>
                }
                else if (_historyError is not null)
                {
                    <PblNotice Tone="warning" Icon="info">The run history could not be read: @_historyError</PblNotice>
                }
                else
                {
                    <PblSkeleton Rows="3" />
                }
            </section>

            <div class="pbl-detail-grid">
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Last run</span>
                    <span class="pbl-detail-value">@Figures.Time(block.LastRunTimeMS) ms</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Average</span>
                    <span class="pbl-detail-value">@Figures.Time(block.RunTimeMSAvg) ms</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Peak</span>
                    <span class="pbl-detail-value">@Figures.Time(block.PeekRunTimeMS) ms</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Offences</span>
                    <span class="pbl-detail-value">@block.Offences</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Recompiles</span>
                    <span class="pbl-detail-value">@block.Recompiles</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Memory</span>
                    <span class="pbl-detail-value">@Figures.Memory(block.MemoryBytes, block.MemoryUnmeasured)</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">State</span>
                    <span class="pbl-detail-value">
                        @if (!block.Enabled)
                        {
                            <PblBadge Text="Off" Tone="neutral" Icon="power" />
                        }
                        else if (block.Resting)
                        {
                            <PblBadge Text="Resting" Tone="neutral" Icon="clock" />
                        }
                        else
                        {
                            <PblBadge Text="On" Tone="success" Icon="check" />
                        }
                    </span>
                </div>
                <div class="pbl-detail pbl-detail-wide">
                    <span class="pbl-detail-label">Entity ID</span>
                    <span class="pbl-detail-value pbl-mono">@block.EntityId</span>
                </div>
                <div class="pbl-detail pbl-detail-wide">
                    <span class="pbl-detail-label">Owner</span>
                    <span class="pbl-detail-value">@block.OwnerName · <span class="pbl-mono">@block.OwnerIdentityId</span></span>
                </div>
            </div>

            <div class="pbl-detail-actions">
                <button type="button" class="pbl-btn" @onclick="() => CopyAsync(block.EntityId)">
                    <PblIcon Name="copy" /> Copy entity ID
                </button>
                @if (_snapshot?.Players.FirstOrDefault(p => p.IdentityId == block.OwnerIdentityId) is { } owner)
                {
                    <button type="button" class="pbl-btn" @onclick="() => ShowPlayer(owner)">
                        <PblIcon Name="users" /> All blocks of @owner.Name
                    </button>
                }
                @if (_canControl && block.Enabled)
                {
                    <button type="button" class="pbl-btn pbl-btn-danger" @onclick="() => AskTurnOffBlock(block)">
                        <PblIcon Name="power" /> Turn off
                    </button>
                }
                <button type="button" class="pbl-btn pbl-btn-ghost" @onclick="CloseDetails">Close</button>
            </div>
        }
    </PblModal>

    <PblModal Open="_selectedPlayer is not null" Title="@(_selectedPlayer?.Name ?? "Player")"
              Subtitle="Total run times, totals and blocks" Icon="users" OnClose="CloseDetails" Class="pbl-modal-wide">
        @if (_selectedPlayer is { } player)
        {
            IReadOnlyList<BlockRowView> playerBlocks = _live.BlocksOf(player);
            <div class="pbl-detail-grid">
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Total last</span>
                    <span class="pbl-detail-value">@Figures.Time(player.CombinedLastRunTimeMS) ms</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Total average</span>
                    <span class="pbl-detail-value">@Figures.Time(player.CombinedRunTimeMSAvg) ms</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Blocks</span>
                    <span class="pbl-detail-value">@player.BlockCount</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Offences</span>
                    <span class="pbl-detail-value">@player.Offences</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Recompiles</span>
                    <span class="pbl-detail-value">@player.Recompiles</span>
                </div>
                <div class="pbl-detail">
                    <span class="pbl-detail-label">Memory</span>
                    <span class="pbl-detail-value">@Figures.MemoryTotal(player.MemoryBytes, player.MemoryUnmeasured)</span>
                </div>
                <div class="pbl-detail pbl-detail-wide">
                    <span class="pbl-detail-label">Tags</span>
                    <span class="pbl-detail-value">
                        @if (player.IsNpc)
                        {
                            <PblBadge Text="NPC" Tone="neutral" />
                        }
                        @if (player.IsPrivileged)
                        {
                            <PblBadge Text="Privileged" Tone="primary" Icon="shield" />
                        }
                        @if (!player.IsNpc && !player.IsPrivileged)
                        {
                            <span class="pbl-muted">None</span>
                        }
                    </span>
                </div>
                <div class="pbl-detail pbl-detail-wide">
                    <span class="pbl-detail-label">Steam ID / identity</span>
                    <span class="pbl-detail-value pbl-mono">@(player.IsNpc ? "NPC" : player.SteamId) · @player.IdentityId</span>
                </div>
            </div>

            <section class="pbl-history" aria-label="Blocks">
                <div class="pbl-history-head">
                    <h3>Blocks, by average</h3>
                    @if (playerBlocks.Count > 0)
                    {
                        <button type="button" class="pbl-btn pbl-btn-ghost pbl-btn-small" @onclick="() => ShowBlocksOf(player)">
                            <PblIcon Name="external" /> Show in the Blocks table
                        </button>
                    }
                </div>
                @if (playerBlocks.Count == 0)
                {
                    <div class="pbl-chart-empty">None of this player's blocks is in the report.</div>
                }
                else
                {
                    <div class="pbl-mini-rows">
                        @foreach (BlockRowView row in playerBlocks.Take(PlayerBlocksShown))
                        {
                            BlockHistoryRowView? history = _history.GetValueOrDefault(row.EntityId);
                            <div class="pbl-mini-row" @key="row.EntityId">
                                <button type="button" class="pbl-mini-row-main" @onclick="() => ShowBlock(row)" title="Details and run history">
                                    <strong>@row.BlockName</strong>
                                    <small>@row.GridName@(row.Enabled ? "" : " · off")@(row.Resting ? " · resting" : "")</small>
                                </button>
                                <span class="pbl-rank-spark">
                                    @if (history is { RunTimesMS.Count: > 1 })
                                    {
                                        <PblSparkline Values="@history.RunTimesMS" Tone="@BlockTable.RunsTone(history)" Label="@($"Last run times of {row.BlockName}")"
                                                      ViewWidth="96" ViewHeight="24" />
                                    }
                                </span>
                                <span class="pbl-num">@Figures.Time(row.RunTimeMSAvg) <small class="pbl-muted">ms avg</small></span>
                                @if (_canControl && row.Enabled)
                                {
                                    <button type="button" class="pbl-icon-btn pbl-icon-btn-danger" title="Turn off" aria-label="@($"Turn off {row.BlockName}")"
                                            @onclick="() => AskTurnOffBlock(row)">
                                        <PblIcon Name="power" />
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    @if (playerBlocks.Count > PlayerBlocksShown)
                    {
                        <p class="pbl-muted">And @(playerBlocks.Count - PlayerBlocksShown) more: see them in the Blocks table.</p>
                    }
                }
            </section>

            <div class="pbl-detail-actions">
                @if (_canControl && (_live.AnyPlayerMayHaveBlocksOn || _live.PlayersWithBlocksOn.Contains(player.IdentityId)))
                {
                    <button type="button" class="pbl-btn pbl-btn-danger" @onclick="() => AskTurnOffPlayer(player)">
                        <PblIcon Name="power" /> Turn off all blocks
                    </button>
                }
                <button type="button" class="pbl-btn pbl-btn-ghost" @onclick="CloseDetails">Close</button>
            </div>
        }
    </PblModal>

    <PblModal Open="_turnOffTarget is not null" Title="@TurnOffTitle" Icon="power"
              OnClose="CancelTurnOff" Locked="_turnOffBusy" Class="pbl-modal-narrow">
        <p>@TurnOffMessage</p>
        <p class="pbl-muted" style="margin-top: 8px;">@(_turnOffTarget?.Player is null ? "It stays" : "They stay") off until turned on again in game.</p>
        <div class="pbl-buttons" style="margin-top: 14px; justify-content: flex-end;">
            <button type="button" class="pbl-btn" @onclick="CancelTurnOff" disabled="@_turnOffBusy" data-autofocus>Cancel</button>
            <button type="button" class="pbl-btn pbl-btn-danger" @onclick="ConfirmTurnOffAsync" disabled="@_turnOffBusy">
                @if (_turnOffBusy)
                {
                    <PblIcon Name="refresh" Class="pbl-spin" />
                    <span>Sending…</span>
                }
                else
                {
                    <PblIcon Name="power" />
                    <span>Turn off</span>
                }
            </button>
        </div>
    </PblModal>
</PageTabs>

@code {
    private static readonly int[] RefreshChoices = [2, 5, 10, 30];
    private const int PlayerBlocksShown = 20;
    private static readonly TimeSpan RequestTimeout = TimeSpan.FromSeconds(10);
    private static readonly TimeSpan ServersRefreshInterval = TimeSpan.FromSeconds(30);
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        Converters = { new JsonStringEnumConverter() }
    };

    private readonly PageClosing _closing = new();
    private readonly SemaphoreSlim _wake = new(0, 1);
    private readonly LiveViewState _live = new();

    private IReadOnlyList<ServerInfo> _servers = Array.Empty<ServerInfo>();
    private string? _serverKey;
    private string? _serverId;
    private string? _snapshotServerId;
    private ReportSnapshotView? _snapshot;

    // The report before the one on show and its server: its rows can still be on screen until the next render, so a click
    // on one is matched to the same block or player in the report on show, when both are of the same server.
    private ReportSnapshotView? _previousSnapshot;
    private string? _previousSnapshotServerId;
    private string? _error;
    private string? _turnOffError;
    private string? _notice;
    private bool _refreshOnce;
    private bool _refreshing;
    private int _refreshSeconds = 5;
    private bool _paused;
    private bool _canControl;
    private bool _controlCheckSlow;  // The permission check at page open has taken over 2 seconds and is still waiting.
    private string? _controlCheckError;
    private DateTime? _lastUpdatedUtc;
    private DateTime _lastServersRefreshUtc;
    private bool _stale;
    private BlockRowView? _selectedBlock;
    private PlayerRowView? _selectedPlayer;
    private bool _serversLoaded;
    private DateTime? _pausedAtUtc;
    private int _filterEdits; // Counts the filter's edits, so the run history is read once the typing stops.
    private bool _serversFailed;
    // The run history of the blocks on show: the selected block, the selected player's, and the table's or Overview's rows.
    private Dictionary<string, BlockHistoryRowView> _history = new();
    private string? _historyError;
    private int _historyRequests; // Counts the history requests, so an answer overtaken by a later request is dropped.
    private PblChartSpec? _blockChart;
    private PblChartSpec? _sessionChart;
    private TurnOffTarget? _turnOffTarget;
    private bool _turnOffBusy;

    private IJSObjectReference? _prefs;
    private IJSObjectReference? _visibility;
    private IJSObjectReference? _clipboard;
    private IJSObjectReference? _download;

    private IReadOnlyList<PblTab> Tabs =>
    [
        new PblTab("overview", "Overview", "activity"),
        new PblTab("blocks", "Blocks", "cube", _live.TotalBlocks),
        new PblTab("players", "Players", "users", _live.TotalPlayers),
    ];

    private IReadOnlyList<PblStateChip> StateChips =>
    [
        new PblStateChip("All", BlockStateFilter.All, _snapshot?.Blocks.Count ?? 0),
        new PblStateChip("On", BlockStateFilter.On, _live.OnCount),
        new PblStateChip("Off", BlockStateFilter.Off, _live.OffCount),
        new PblStateChip("Resting", BlockStateFilter.Resting, _live.RestingCount),
        new PblStateChip("Offences", BlockStateFilter.Offences, _live.OffenceBlockCount),
    ];

    private ServerInfo? SelectedServer => _servers.FirstOrDefault(server => server.PickKey == _serverKey);

    private string BlockSubtitle => _selectedBlock is { } block
        ? $"{block.GridName} · {block.OwnerName}"
        : "";

    private string MemoryValue => _live.MemoryUnmeasured
        ? (_live.MemoryBytes > 0 ? MemoryText.Size(_live.MemoryBytes) : MemoryText.NotMeasurable)
        : MemoryText.Size(_live.MemoryBytes);

    private string MemoryHint => _live.MemoryUnmeasured
        ? "Plus scripts that could not be measured"
        : "Measured script memory";

    private string TurnOffTitle => _turnOffTarget switch
    {
        { Block: { } block } => "Turn off " + block.BlockName + "?",
        { Player: { } player } => $"Turn off all {player.BlockCount} of {player.Name}'s blocks?",
        _ => "Turn off?"
    };

    private string TurnOffMessage => _turnOffTarget switch
    {
        { Block: { } block } => $"{block.GridName} · owned by {block.OwnerName}. Its script stops now.",
        { Player: { } player } => $"Every tracked programmable block {player.Name} owns stops now.",
        _ => ""
    };

    private static string InstantKillText(BlockHistoryRowView history)
    {
        if (history.InstantKillMS <= 0) return "Instant kill is off";
        string above = $"above {Figures.Time(history.InstantKillMS)} ms";
        return history.InstantKillStrikes <= 1
            ? $"Instant kill at the first run {above}"
            : $"Instant kill after {history.InstantKillStrikes} runs {above} within {history.InstantKillStrikeWindow} s";
    }

    private string TableSubtitle(int shown, int total) =>
        $"{shown} shown of {total} tracked" + (_live.HoldingOrder ? " · order held while the pointer is on the table" : "");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _prefs = await ImportAsync("prefs.js");
        }
        catch (Exception e)
        {
            Log.LogDebug(e, "Could not load the PB Limiter UI preferences");
            _prefs = null;
        }

        await LoadPreferencesAsync();

        try
        {
            await RefreshServersAsync(_closing.Token);
        }
        catch (Exception e)
        {
            Log.LogDebug(e, "Could not read the PB Limiter server list");
            _error = "Could not read the server list: " + PageShared.ShortError(e);
            _serversFailed = true;
        }

        _serversLoaded = true;
        ApplyPreferenceSelection();

        // Not awaited: the page shows its report while Quasar answers, however long that takes.
        _ = CheckControlAtStartAsync();
    }

    /// <summary>
    /// Asks whether the user may control servers, with no time limit: the Turn off buttons appear once Quasar answers. If
    /// the answer takes more than 2 seconds, a notice says it is still being checked, so a missing button is explained.
    /// </summary>
    private async Task CheckControlAtStartAsync()
    {
        try
        {
            Task<bool> asking = SdkClient.AllowedAsync(JS, "CanControlServers", _closing.Token);
            if (await Task.WhenAny(asking, Task.Delay(2000)) != asking)
            {
                _controlCheckSlow = true;
                await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));
            }
            _canControl = await asking;
        }
        catch (OperationCanceledException) when (_closing.IsClosed)
        {
            return; // The page closed while it asked.
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not check the PB Limiter control permission");
            _canControl = false;
            _controlCheckError = "Could not check your permission to turn blocks off, so no Turn off buttons are shown: " + PageShared.ShortError(e);
        }
        _controlCheckSlow = false;
        await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _visibility = await ImportAsync("visibility.js");
        }
        catch (Exception e)
        {
            Log.LogDebug(e, "Could not load the PB Limiter visibility helper");
            _visibility = null;
        }

        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        CancellationToken closing = _closing.Token;
        try
        {
            while (!closing.IsCancellationRequested)
            {
                bool visible = true;
                if (_visibility is not null)
                {
                    try
                    {
                        visible = await _visibility.InvokeAsync<bool>("isVisible");
                    }
                    catch (Exception e)
                    {
                        Log.LogDebug(e, "Could not read the PB Limiter page visibility");
                        visible = true;
                    }
                }

                if (visible && (!_paused || _refreshOnce))
                {
                    _refreshOnce = false;
                    await RefreshAsync(closing);
                }
                else if (visible && _paused && DateTime.UtcNow - _lastServersRefreshUtc >= ServersRefreshInterval)
                {
                    try
                    {
                        // Paused, the new server on show is read once, at once, as when an admin picks one.
                        if (await RefreshServersAsync(closing))
                        {
                            _refreshOnce = true;
                            Wake();
                        }
                    }
                    catch (OperationCanceledException) when (closing.IsCancellationRequested)
                    {
                        throw;
                    }
                    catch (Exception e)
                    {
                        Log.LogDebug(e, "Could not read the PB Limiter server list");
                        _serversFailed = true;
                        if (PageShared.ReportReadFailures.IsNew("servers", e.Message))
                            Log.LogWarning(e, "Could not read the PB Limiter server list");
                    }
                    // Paused, nothing else renders: a server list change, or a switch, shows now.
                    await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));
                }

                TimeSpan wait = visible ? TimeSpan.FromSeconds(_refreshSeconds) : TimeSpan.FromSeconds(2);
                await _wake.WaitAsync(wait, closing);
            }
        }
        catch (OperationCanceledException) when (closing.IsCancellationRequested)
        {
            // The page closed.
        }
    }

    private async Task RefreshAsync(CancellationToken closing)
    {
        _refreshing = true;
        await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));

        try
        {
            if (DateTime.UtcNow - _lastServersRefreshUtc >= ServersRefreshInterval)
            {
                try
                {
                    // A switch drops the old server's view: shown at once, not after the new report arrives.
                    if (await RefreshServersAsync(closing))
                        await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));
                }
                catch (OperationCanceledException) when (closing.IsCancellationRequested)
                {
                    throw;
                }
                catch (Exception e)
                {
                    Log.LogDebug(e, "Could not read the PB Limiter server list");
                    _serversFailed = true;
                    if (_snapshot is null)
                        _error = "Could not read the server list: " + PageShared.ShortError(e);
                    if (PageShared.ReportReadFailures.IsNew("servers", e.Message))
                        Log.LogWarning(e, "Could not read the PB Limiter server list");
                }
            }

            string? serverId = _serverId;
            if (serverId is null)
            {
                _snapshot = null;
                _snapshotServerId = null;
                _error = null;
                _stale = false;
                _live.SetServer();
                return;
            }

            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(closing);
            timeout.CancelAfter(RequestTimeout);

            try
            {
                ReportSnapshotView snapshot = await SdkClient.RequestAsync<ReportSnapshotView>(
                    JS, UiOperations.Snapshot, new ReadSnapshotRequest { ServerId = serverId }, timeout.Token);

                if (serverId != _serverId) return;

                bool changed = _snapshotServerId != serverId;
                _previousSnapshot = _snapshot;
                _previousSnapshotServerId = _snapshotServerId;
                _snapshot = snapshot;
                _snapshotServerId = serverId;
                _lastUpdatedUtc = DateTime.UtcNow;
                _error = null;
                _stale = false;
                _live.SetSnapshot(snapshot, resetHistory: changed);
                _sessionChart = ChartSpecs.Session(_live.History);
                if (changed)
                    _history = new Dictionary<string, BlockHistoryRowView>();

                // The dialog follows its block or player to the new figures, and closes when it has left the report.
                if (_selectedBlock is not null)
                {
                    _selectedBlock = snapshot.Blocks.FirstOrDefault(block => block.EntityId == _selectedBlock.EntityId);
                    if (_selectedBlock is null) _blockChart = null;
                }
                if (_selectedPlayer is not null)
                    _selectedPlayer = snapshot.Players.FirstOrDefault(player => player.IdentityId == _selectedPlayer.IdentityId);

                // The new report is drawn before its run history is read, so the rows on screen are the ones on show.
                await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));
                await LoadHistoryAsync(serverId, closing);
            }
            catch (OperationCanceledException) when (closing.IsCancellationRequested)
            {
                throw;
            }
            catch (OperationCanceledException)
            {
                if (serverId == _serverId)
                {
                    _error = "The server did not answer in time.";
                    _stale = _snapshot is not null;
                }

                _lastServersRefreshUtc = DateTime.UtcNow.AddSeconds(-25);
            }
            catch (Exception e)
            {
                Log.LogDebug(e, "Could not read the PB Limiter report of {Server}", ServerName(serverId));
                if (PageShared.ReportReadFailures.IsNew(serverId, e.Message))
                    Log.LogWarning(e, "Could not read the PB Limiter report of {Server}", ServerName(serverId));

                if (serverId == _serverId)
                {
                    _error = "Could not read the report: " + PageShared.ShortError(e) + CompanionErrors.RestartHint(e);
                    _stale = _snapshot is not null;
                }

                _lastServersRefreshUtc = DateTime.UtcNow.AddSeconds(-25);
            }
        }
        finally
        {
            _refreshing = false;
            await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));
        }
    }

    /// <summary>Reads the server list. True when the server on show changed, and its view was dropped.</summary>
    private async Task<bool> RefreshServersAsync(CancellationToken closing)
    {
        ServerListResponse response = await SdkClient.RequestAsync<ServerListResponse>(
            JS, UiOperations.Servers, new EmptyPayload(), closing);

        _servers = response.Servers
            .OrderByDescending(server => server.Connected)
            .ThenBy(server => server.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _lastServersRefreshUtc = DateTime.UtcNow;
        _serversLoaded = true;
        _serversFailed = false;

        string? shownId = _serverId;
        if (_serverKey is null || _servers.All(server => server.PickKey != _serverKey))
            _serverKey = _servers.FirstOrDefault(server => server.Connected)?.PickKey
                         ?? _servers.FirstOrDefault()?.PickKey;

        ServerInfo? selected = _servers.FirstOrDefault(server => server.PickKey == _serverKey);
        _serverId = selected?.ServerId;
        // The server on show changed: it left the list and another was picked, or a cluster node restarted in the same
        // slot under a new id. Nothing of the old one may stay, not its rows, dialogs or owner filter.
        if (shownId == _serverId) return false;
        if (shownId is not null) ForgetServerView();
        return _serverId is not null;
    }

    private void ApplyPreferenceSelection()
    {
        if (_servers.Count == 0)
        {
            _serverKey = null;
            _serverId = null;
            return;
        }

        // The server remembered from the last visit, unless it is offline now and another is connected.
        if (_serverKey is null || _servers.All(server => server.PickKey != _serverKey || !server.Connected))
            _serverKey = _servers.FirstOrDefault(server => server.Connected)?.PickKey
                         ?? _servers.FirstOrDefault(server => server.PickKey == _serverKey)?.PickKey
                         ?? _servers.FirstOrDefault()?.PickKey;

        _serverId = _servers.FirstOrDefault(server => server.PickKey == _serverKey)?.ServerId;
    }

    private void RefreshNow()
    {
        _refreshOnce = true;
        Wake();
    }

    private void Wake()
    {
        if (_wake.CurrentCount == 0)
            _wake.Release();
    }

    private string ServerName(string serverId) =>
        _servers.FirstOrDefault(server => server.ServerId == serverId)?.DisplayName ?? serverId;

    private void ServerChanged(ChangeEventArgs args)
    {
        // The picker is disabled while a turn-off is sending, so the dialog stays until the result.
        if (_turnOffBusy) return;
        _serverKey = args.Value?.ToString();
        _serverId = _servers.FirstOrDefault(server => server.PickKey == _serverKey)?.ServerId;
        ForgetServerView();
        _refreshOnce = true;
        _ = SavePreferencesAsync();
        Wake();
    }

    /// <summary>Drops everything shown for the server before: its report, history, dialogs, messages and owner filter.</summary>
    private void ForgetServerView()
    {
        _snapshot = null;
        _snapshotServerId = null;
        _previousSnapshot = null;
        _previousSnapshotServerId = null;
        _error = null;
        _turnOffError = null;
        _notice = null;
        _selectedBlock = null;
        _selectedPlayer = null;
        _turnOffTarget = null;
        _lastUpdatedUtc = null;
        _stale = false;
        _live.SetServer();
        _history = new Dictionary<string, BlockHistoryRowView>();
        _historyError = null;
        _blockChart = null;
        _sessionChart = null;
    }

    /// <summary>What became of the runs over the run-time limit, from the outcomes kept as each came.</summary>
    private static string OutcomeText(int forgiven, int counted, int notChecked)
    {
        List<string> parts = new(3);
        if (forgiven > 0) parts.Add($"{forgiven} forgiven as {(forgiven == 1 ? "a spike" : "spikes")}");
        if (counted > 0) parts.Add($"{counted} counted");
        if (notChecked > 0) parts.Add($"{notChecked} not checked (grace after an offence, a pending punishment, sim speed, the limiter off, or the block instant-killed)");
        return parts.Count == 0 ? "" : "· " + string.Join(", ", parts);
    }

    private static string LeftOutText(BlockHistoryRowView history)
    {
        int count = history.LeftOutOfAverage.Count;
        return history.RunTimesMS.Count >= 10
            ? $"the {InvariantText.Count(count, "slowest run is", "slowest runs are")} left out of it"
            : $"{InvariantText.Count(count, "run forgiven as a spike is", "runs forgiven as spikes are")} left out of it";
    }

    private void RefreshChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int seconds)
            && RefreshChoices.Contains(seconds))
        {
            _refreshSeconds = seconds;
            _ = SavePreferencesAsync();
            Wake();
        }
    }

    private void TogglePaused()
    {
        _paused = !_paused;
        _pausedAtUtc = _paused ? DateTime.UtcNow : null;
        Wake();
    }

    /// <summary>Holds or releases the rows' order; rows a release brings onto the page get their run history at once.</summary>
    private Task HoldOrder(bool hold) => _live.SetHoldOrder(hold) ? LoadHistoryNowAsync() : Task.CompletedTask;

    /// <summary>For a turn-off: asks whether the user may control servers, giving up after <see cref="RequestTimeout"/>.</summary>
    private async Task<bool> CanControlAsync()
    {
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(_closing.Token);
        timeout.CancelAfter(RequestTimeout);
        return await SdkClient.AllowedAsync(JS, "CanControlServers", timeout.Token);
    }

    private Task FilterChanged(ChangeEventArgs args)
    {
        _live.SetFilter(args.Value?.ToString() ?? "");
        _ = LoadHistoryAfterTypingAsync(++_filterEdits);
        return SavePreferencesAsync();
    }

    /// <summary>Reads the run history of the rows the filter left once it has not changed for 300 ms, not on every key.</summary>
    private async Task LoadHistoryAfterTypingAsync(int edit)
    {
        await Task.Delay(300);
        if (edit != _filterEdits || _closing.IsClosed) return;
        await LoadHistoryNowAsync();
        await PageShared.RenderIfOpenAsync(_closing, () => InvokeAsync(StateHasChanged));
    }

    private Task ClearOwnerFilter()
    {
        _live.ClearOwnerFilter();
        return LoadHistoryNowAsync();
    }

    private Task StateFilterChanged(BlockStateFilter filter)
    {
        _live.SetStateFilter(filter);
        return ShownRowsChangedAsync();
    }

    private Task ClearFilters()
    {
        _live.ClearFilters();
        return ShownRowsChangedAsync();
    }

    private Task SortBy(string column)
    {
        _live.SetSort(column);
        return ShownRowsChangedAsync();
    }

    private Task TabChanged(string key)
    {
        _live.SetTab(key switch
        {
            "blocks" => LiveTab.Blocks,
            "players" => LiveTab.Players,
            _ => LiveTab.Overview
        });
        return ShownRowsChangedAsync();
    }

    private Task BlockPageChanged(int page)
    {
        _live.SetBlockPage(page);
        return LoadHistoryNowAsync();
    }

    private void PlayerPageChanged(int page) => _live.SetPlayerPage(page);

    private Task PageSizeChanged(int size)
    {
        _live.SetPageSize(size);
        return ShownRowsChangedAsync();
    }

    private Task ShowBlocksOf(PlayerRowView player)
    {
        _selectedPlayer = null;
        _live.ShowBlocksOf(player);
        return ShownRowsChangedAsync();
    }

    /// <summary>The choices are saved, and the rows now on show get their run history without waiting for the next refresh.</summary>
    private async Task ShownRowsChangedAsync()
    {
        await SavePreferencesAsync();
        await LoadHistoryNowAsync();
    }

    private Task ShowBlock(BlockRowView row)
    {
        // A turn-off that is sending keeps its dialog until the result, as CancelTurnOff does.
        if (TurnOffStillSending() || CurrentRow(row) is not { } current) return Task.CompletedTask;
        _selectedPlayer = null;
        _selectedBlock = current;
        _turnOffTarget = null;
        RefreshBlockChart();
        return LoadHistoryNowAsync();
    }

    private Task ShowPlayer(PlayerRowView row)
    {
        if (TurnOffStillSending() || CurrentRow(row) is not { } current) return Task.CompletedTask;
        _selectedBlock = null;
        _selectedPlayer = current;
        _turnOffTarget = null;
        _blockChart = null;
        return LoadHistoryNowAsync();
    }

    private void CloseDetails()
    {
        _selectedBlock = null;
        _selectedPlayer = null;
        _blockChart = null;
    }

    /// <summary>
    /// The blocks whose run history is on show, at most a request's worth: the dialog's first, then the rows. With each
    /// block's owner, so the server looks it up there.
    /// </summary>
    private BlockHistoryUiRequest HistoryRequest(string serverId)
    {
        BlockHistoryUiRequest request = new() { ServerId = serverId };
        HashSet<string> seen = new(StringComparer.Ordinal);
        void Add(BlockRowView row)
        {
            if (request.EntityIds.Count >= BlockHistoryResult.MaxBlocks || !seen.Add(row.EntityId)) return;
            request.EntityIds.Add(row.EntityId);
            request.OwnerIds.Add(row.OwnerIdentityId);
        }

        if (_selectedBlock is { } block) Add(block);
        if (_selectedPlayer is { } player)
        {
            foreach (BlockRowView row in _live.BlocksOf(player).Take(PlayerBlocksShown)) Add(row);
        }
        IReadOnlyList<BlockRowView> rows = _live.Tab switch
        {
            LiveTab.Blocks => _live.PageBlocks,
            LiveTab.Overview => _live.TopBlocks,
            _ => Array.Empty<BlockRowView>()
        };
        foreach (BlockRowView row in rows) Add(row);
        return request;
    }

    /// <summary>
    /// Reads the run history of the blocks on show. A failure keeps the history read before, and its reason shows in the
    /// block dialog: the table and the rest of the page do not depend on it.
    /// </summary>
    private async Task LoadHistoryAsync(string serverId, CancellationToken closing)
    {
        int request = ++_historyRequests;
        BlockHistoryUiRequest wanted = HistoryRequest(serverId);
        if (wanted.EntityIds.Count == 0)
        {
            _history = new Dictionary<string, BlockHistoryRowView>();
            RefreshBlockChart();
            return;
        }

        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(closing);
        timeout.CancelAfter(RequestTimeout);
        try
        {
            BlockHistoryView view = await SdkClient.RequestAsync<BlockHistoryView>(JS, UiOperations.BlockHistory,
                wanted, timeout.Token);
            if (request != _historyRequests || serverId != _serverId) return;

            Dictionary<string, BlockHistoryRowView> history = new(StringComparer.Ordinal);
            foreach (BlockHistoryRowView row in view.Blocks)
                history[row.EntityId] = row;
            _history = history;
            _historyError = null;
        }
        catch (OperationCanceledException) when (closing.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception e)
        {
            if (request != _historyRequests || serverId != _serverId) return;
            Log.LogDebug(e, "Could not read the PB Limiter run history of {Server}", ServerName(serverId));
            _historyError = e is OperationCanceledException
                ? "the server did not answer in time."
                : PageShared.ShortError(e) + CompanionErrors.RestartHint(e);
        }

        RefreshBlockChart();
    }

    /// <summary>Reads the run history at once, for rows or a dialog the admin just brought up, and shows it.</summary>
    private async Task LoadHistoryNowAsync()
    {
        if (_serverId is not { } serverId || _snapshot is null || _closing.IsClosed) return;
        try
        {
            await LoadHistoryAsync(serverId, _closing.Token);
        }
        catch (OperationCanceledException)
        {
            // The page closed.
        }
    }

    private void RefreshBlockChart()
    {
        _blockChart = _selectedBlock is { } block && _history.TryGetValue(block.EntityId, out BlockHistoryRowView? history) && history.RunTimesMS.Count > 0
            ? ChartSpecs.Runs(history, $"Last {history.RunTimesMS.Count} run times of {block.BlockName}")
            : null;
    }

    /// <summary>
    /// The row a click on <paramref name="row"/> is for, in the report on show: the row itself, or, for a row still on screen
    /// from the report before it of the same server, the same block in the report on show. Null, with a toast, for a row
    /// of another server's report or a block no longer listed: nothing is done for it.
    /// </summary>
    private BlockRowView? CurrentRow(BlockRowView row)
    {
        if (_snapshot is not null && _snapshot.Blocks.Contains(row)) return row;
        BlockRowView? current = FromPreviousReport() && _previousSnapshot!.Blocks.Contains(row)
            ? _snapshot!.Blocks.Find(block => block.EntityId == row.EntityId)
            : null;
        if (current is null) ToastService.Show($"{row.BlockName} is not in the report on show any more.", ToastTone.Warning);
        return current;
    }

    /// <inheritdoc cref="CurrentRow(BlockRowView)"/>
    private PlayerRowView? CurrentRow(PlayerRowView row)
    {
        if (_snapshot is not null && _snapshot.Players.Contains(row)) return row;
        PlayerRowView? current = FromPreviousReport() && _previousSnapshot!.Players.Contains(row)
            ? _snapshot!.Players.Find(player => player.IdentityId == row.IdentityId)
            : null;
        if (current is null) ToastService.Show($"{row.Name} is not in the report on show any more.", ToastTone.Warning);
        return current;
    }

    /// <summary>The report on show replaced one of the same server, whose rows may still be on screen.</summary>
    private bool FromPreviousReport() =>
        _snapshot is not null && _previousSnapshot is not null && _snapshotServerId is not null && _previousSnapshotServerId == _snapshotServerId;

    // A turn-off is asked for the row in the report on show, and keeps that report's server. One at a time.
    private void AskTurnOffBlock(BlockRowView row)
    {
        if (TurnOffStillSending() || CurrentRow(row) is not { } current) return;
        _selectedBlock = null;
        _selectedPlayer = null;
        _turnOffTarget = new TurnOffTarget("block", current, null, _snapshotServerId!);
    }

    private void AskTurnOffPlayer(PlayerRowView row)
    {
        if (TurnOffStillSending() || CurrentRow(row) is not { } current) return;
        _selectedBlock = null;
        _selectedPlayer = null;
        _turnOffTarget = new TurnOffTarget("player", null, current, _snapshotServerId!);
    }

    private bool TurnOffStillSending()
    {
        if (!_turnOffBusy) return false;
        ToastService.Show("A turn-off is still being sent: wait for its result.", ToastTone.Warning);
        return true;
    }

    // Once confirmed, a turn-off goes: the dialog stays until its result, as a request sent cannot be called back.
    private void CancelTurnOff()
    {
        if (!_turnOffBusy) _turnOffTarget = null;
    }

    private async Task ConfirmTurnOffAsync()
    {
        // Checked and set before anything awaits: the page runs one event at a time, so a second click, however quick, sees it.
        TurnOffTarget? target = _turnOffTarget;
        if (target is null || _turnOffBusy) return;

        _turnOffBusy = true;
        try
        {
            if (target.Block is not null)
                await TurnOffBlockAsync(target.ServerId, target.Block);
            else if (target.Player is not null)
                await TurnOffPlayerAsync(target.ServerId, target.Player);
        }
        finally
        {
            _turnOffBusy = false;
            // Only this dialog: a server switch meanwhile may have closed it, and nothing newer opens while it runs.
            if (ReferenceEquals(_turnOffTarget, target))
                _turnOffTarget = null;
        }
    }

    private Task TurnOffBlockAsync(string serverId, BlockRowView row)
    {
        return RunTurnOffAsync(serverId, $"{row.BlockName} on {row.GridName}",
            (serverId, token) => SdkClient.RequestAsync<TurnOffResult>(JS, UiOperations.TurnOffBlock,
                new TurnOffBlockUiRequest { ServerId = serverId, EntityId = row.EntityId }, token));
    }

    private Task TurnOffPlayerAsync(string serverId, PlayerRowView row)
    {
        return RunTurnOffAsync(serverId, $"all of {row.Name}'s blocks",
            (serverId, token) => SdkClient.RequestAsync<TurnOffResult>(JS, UiOperations.TurnOffPlayer,
                new TurnOffPlayerUiRequest { ServerId = serverId, IdentityId = row.IdentityId }, token));
    }

    /// <param name="serverId">The server whose report the row came from: the request goes there, and only while it is still on show.</param>
    private async Task RunTurnOffAsync(string serverId, string what, Func<string, CancellationToken, Task<TurnOffResult>> turnOff)
    {
        _notice = null;
        _turnOffError = null;

        bool canControl;
        try
        {
            canControl = await CanControlAsync();
        }
        catch (OperationCanceledException) when (_closing.IsClosed)
        {
            return; // The page closed.
        }
        catch (OperationCanceledException)
        {
            PermissionError(serverId, "Could not check your permission in time, so nothing was turned off. Try again.", ToastTone.Warning);
            return;
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not check your permission to control PB Limiter servers");
            PermissionError(serverId, "Could not check your permission: " + PageShared.ShortError(e), ToastTone.Danger);
            return;
        }

        if (!canControl)
        {
            PermissionError(serverId, "You do not have permission to control servers.", ToastTone.Danger);
            return;
        }

        string serverName = ServerName(serverId);

        // The page moved to another server while the permission was checked: the admin confirmed it for the other one.
        if (serverId != _serverId)
        {
            ToastService.Show($"Nothing was turned off: the page moved from {serverName} before {what} was sent.", ToastTone.Warning);
            return;
        }

        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(_closing.Token);
        timeout.CancelAfter(RequestTimeout);
        try
        {
            TurnOffResult result = await turnOff(serverId, timeout.Token);
            Log.LogInformation("Turned off {What} on {Server}, {Count}", what, serverName,
                InvariantText.Count(result.TurnedOff, "block", "blocks"));

            string done = result.TurnedOff == 0
                ? $"Nothing to turn off for {what} on {serverName}: already off, or no longer tracked."
                : $"Turned off {what} on {serverName}: {InvariantText.Count(result.TurnedOff, "block", "blocks")}.";
            ToastService.Show(done, result.TurnedOff == 0 ? ToastTone.Warning : ToastTone.Success);
            if (serverId != _serverId) return;

            _notice = done;
            _error = null;
            Wake();
        }
        catch (OperationCanceledException) when (_closing.IsClosed)
        {
            // The page closed.
        }
        catch (OperationCanceledException)
        {
            string timedOut = $"{serverName} did not answer in time, so it may or may not have turned off {what}. Check its report to see which.";
            ToastService.Show(timedOut, ToastTone.Warning);
            if (serverId == _serverId)
                _turnOffError = timedOut;

            Wake();
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not turn off {What} on {Server}", what, serverName);
            string failed = $"Could not confirm the result of turning off {what} on {serverName}: {PageShared.ShortError(e).TrimEnd('.')}. Check its report to see what is off.";
            ToastService.Show(failed, ToastTone.Danger);
            if (serverId == _serverId)
                _turnOffError = failed;

            Wake();
        }
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            _clipboard ??= await ImportAsync("clipboard.js");
            await _clipboard.InvokeVoidAsync("copy", text);
            ToastService.Show("Copied to the clipboard.", ToastTone.Success, 2);
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not copy to the clipboard");
            ToastService.Show("Could not copy: " + PageShared.ShortError(e), ToastTone.Danger);
        }
    }

    private async Task DownloadCsvAsync()
    {
        if (_snapshot is null) return;

        try
        {
            _download ??= await ImportAsync("download.js");
            string csv = CsvExport.ForBlocks(_snapshot, ServerName(_snapshotServerId ?? ""));
            string fileName = $"pb-limiter-{FileNamePart(ServerName(_snapshotServerId ?? ""))}-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv";
            await _download.InvokeVoidAsync("downloadText", fileName, "\uFEFF" + csv, "text/csv;charset=utf-8");
            ToastService.Show("CSV downloaded.", ToastTone.Success, 2);
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not save the PB Limiter CSV");
            ToastService.Show("Could not save the CSV: " + PageShared.ShortError(e), ToastTone.Danger);
        }
    }

    private void ClearError() => _error = null;
    private void ClearControlCheckError() => _controlCheckError = null;
    private void ClearTurnOffError() => _turnOffError = null;

    /// <summary>A failed confirm-time permission check: a toast, and the banner only while the server it was for is on show.</summary>
    private void PermissionError(string serverId, string message, ToastTone tone)
    {
        if (serverId == _serverId) _turnOffError = message;
        ToastService.Show(message, tone);
    }
    private void ClearNotice() => _notice = null;

    private async Task LoadPreferencesAsync()
    {
        if (_prefs is null) return;

        try
        {
            await _prefs.InvokeVoidAsync("remove", UiPreferences.OldKey);
            string? json = await _prefs.InvokeAsync<string?>("load", UiPreferences.Key);
            if (string.IsNullOrWhiteSpace(json)) return;

            UiPreferences? preferences = JsonSerializer.Deserialize<UiPreferences>(json, JsonOptions);
            if (preferences is null) return;

            _live.ApplyPreferences(preferences);
            if (RefreshChoices.Contains(preferences.RefreshSeconds))
                _refreshSeconds = preferences.RefreshSeconds;
            _serverKey = preferences.ServerKey;
        }
        catch (Exception e)
        {
            Log.LogDebug(e, "Could not read the PB Limiter UI preferences");
        }
    }

    private async Task SavePreferencesAsync()
    {
        if (_prefs is null) return;

        try
        {
            UiPreferences preferences = _live.ToPreferences();
            preferences.ServerKey = _serverKey;
            preferences.RefreshSeconds = _refreshSeconds;
            await _prefs.InvokeVoidAsync("save", UiPreferences.Key, JsonSerializer.Serialize(preferences, JsonOptions));
        }
        catch (Exception e)
        {
            Log.LogDebug(e, "Could not save the PB Limiter UI preferences");
        }
    }

    private async Task<IJSObjectReference> ImportAsync(string file)
    {
        string url = new Uri(new Uri(Navigation.BaseUri),
            $"_quasar/plugins/{SdkClient.PluginId}/{file}").ToString();
        return await JS.InvokeAsync<IJSObjectReference>("import", url);
    }

    /// <summary>A server name made safe for a file name: letters and digits, other runs as one dash.</summary>
    private static string FileNamePart(string name)
    {
        System.Text.StringBuilder part = new(name.Length);
        foreach (char c in name)
        {
            if (char.IsAsciiLetterOrDigit(c)) part.Append(char.ToLowerInvariant(c));
            else if (part.Length > 0 && part[^1] != '-') part.Append('-');
        }
        string text = part.ToString().Trim('-');
        return text.Length == 0 ? "server" : text.Length > 40 ? text[..40].TrimEnd('-') : text;
    }

    private static string BarPercent(double value, double max)
    {
        if (max <= 0) return "0";
        double percent = Math.Clamp(value / max * 100d, 0d, 100d);
        return percent.ToString("0.#", CultureInfo.InvariantCulture);
    }

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        string trimmed = name.Trim();
        string[] words = trimmed.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length >= 2)
            return (char.ToUpperInvariant(words[0][0]).ToString() + char.ToUpperInvariant(words[1][0])).Trim();

        return trimmed.Length >= 2
            ? trimmed[..2].ToUpperInvariant()
            : trimmed[..1].ToUpperInvariant();
    }

    private static int AvatarIndex(string name)
    {
        int hash = 0;
        foreach (char c in name)
            hash = ((hash * 31) + c) & 0x7fffffff;
        return hash % 6;
    }

    public async ValueTask DisposeAsync()
    {
        _closing.Dispose();
        await DisposeModuleAsync(_visibility);
        await DisposeModuleAsync(_prefs);
        await DisposeModuleAsync(_clipboard);
        await DisposeModuleAsync(_download);
    }

    private static async Task DisposeModuleAsync(IJSObjectReference? module)
    {
        if (module is null) return;

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser page is gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed.
        }
    }

