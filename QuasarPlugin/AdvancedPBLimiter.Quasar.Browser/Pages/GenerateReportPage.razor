@page "/advanced-pb-limiter/generate-report"
@attribute [Authorize(Policy = "CanView")]
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<GenerateReportPage> Log
@using System.Globalization

<PageTitle>PB Limiter report</PageTitle>

<PageTabs Active="PageTabs.Tab.Report" Description="Build one text report covering the servers you choose, with totals across all of them and the detail of each.">
    @if (_error is not null)
    {
        <PblNotice Tone="danger" Icon="alert" Dismiss="ClearError">@_error</PblNotice>
    }

    <PblCard Title="Choose servers" Subtitle="A report can only include servers that are online right now.">
        @if (_servers.Count == 0)
        {
            <PblEmptyState Icon="server" Title="No servers yet" Description="A server is listed here once it has connected to Quasar." />
        }
        else
        {
            <PblServerPicker Servers="_servers" Selected="Picked.Ids" OnlineOnly="true" Changed="ServersPicked" />

            <div class="pbl-buttons" style="margin-top: 12px;">
                <button type="button" class="pbl-btn pbl-btn-primary"
                        disabled="@(_busy || !SelectedConnected.Any())"
                        @onclick="GenerateAsync">
                    @if (_busy)
                    {
                        <PblIcon Name="refresh" Class="pbl-spin" />
                    }
                    else
                    {
                        <PblIcon Name="file" />
                    }
                    @(_busy ? "Generating…" : "Generate report")
                </button>
                <span class="pbl-muted">@InvariantText.Count(SelectedConnected.Count(), "server", "servers") selected.</span>
            </div>
        }
    </PblCard>

    @if (_busy || _progress.Count > 0)
    {
        <PblCard Title="Progress" Subtitle="Each server answers on its own." Class="pbl-section-gap">
            <div class="pbl-timeline">
                @foreach (ServerInfo server in _servers.Where(server => Picked.Ids.Contains(server.PickKey)))
                {
                    string state = _progress.TryGetValue(server.ServerId, out string? progress) ? progress : "Waiting";
                    <div class="pbl-timeline-row" @key="server.ServerId">
                        <span class="pbl-timeline-dot @ProgressTone(state)"></span>
                        <div class="pbl-timeline-main">
                            <strong>@server.DisplayName</strong>
                            <small>@state</small>
                        </div>
                    </div>
                }
            </div>
        </PblCard>
    }

    @if (_results is not null)
    {
        <PblCard Title="Report" Subtitle="@ReportSummary" Class="pbl-section-gap">
            @if (_results.Count == 0)
            {
                <PblEmptyState Icon="file" Title="Nothing to show" Description="None of the selected servers answered." />
            }
            else
            {
                <div class="pbl-report-grid">
                    @foreach (ServerReport result in _results)
                    {
                        <div class="pbl-report-card" @key="result.ServerName">
                            <div class="pbl-report-card-head">
                                <strong>@result.ServerName</strong>
                                @if (result.Snapshot is not null)
                                {
                                    <PblBadge Text="Included" Tone="success" Icon="check" />
                                }
                                else
                                {
                                    <PblBadge Text="Not included" Tone="danger" Icon="alert" />
                                }
                            </div>

                            @if (result.Snapshot is { } snapshot)
                            {
                                <p>
                                    @InvariantText.Count(snapshot.Players.Count, "player", "players") ·
                                    @InvariantText.Count(snapshot.Players.Sum(player => player.BlockCount), "block", "blocks") ·
                                    @InvariantText.Count(snapshot.Players.Sum(player => player.Offences), "offence", "offences")
                                </p>
                                @if (snapshot.Truncated)
                                {
                                    <p class="pbl-muted">Some blocks are not listed; totals still count them.</p>
                                }
                            }
                            else
                            {
                                <p>@result.Problem</p>
                            }
                        </div>
                    }
                </div>

                @if (_reportText is not null)
                {
                    <div class="pbl-report-actions">
                        <button type="button" class="pbl-btn" @onclick="CopyReportAsync">
                            <PblIcon Name="copy" /> Copy report
                        </button>
                        <button type="button" class="pbl-btn" @onclick="DownloadAsync">
                            <PblIcon Name="download" /> Download .txt
                        </button>
                        <button type="button" class="pbl-btn pbl-btn-ghost" @onclick="DownloadCsvAsync">
                            <PblIcon Name="download" /> Download .csv
                        </button>
                    </div>

                    <pre class="pbl-report-preview">@_reportText</pre>
                    <p class="pbl-muted" style="margin-top: 8px;">Saved by your browser. Nothing is kept on the server.</p>
                }
                else
                {
                    <p class="pbl-muted">None of the selected servers answered, so there is nothing to download.</p>
                }
            }
        </PblCard>
    }
</PageTabs>

@code {
    private static readonly TimeSpan RequestTimeout = TimeSpan.FromSeconds(20);

    private readonly PageClosing Closing = new();
    private readonly Dictionary<string, string> _progress = new(StringComparer.Ordinal);
    private List<ServerInfo> _servers = new();

    private List<ServerReport>? _results;
    private string? _reportText;
    private string _fileName = "";
    private string? _error;
    private bool _busy;
    // Counts the admin's changes to the ticks, so a report generated for ticks changed while it was on its way is dropped.
    private int _picks;

    private IJSObjectReference? _download;
    private IJSObjectReference? _clipboard;

    private PickedServers Picked { get; } = new();
    private IEnumerable<ServerInfo> SelectedConnected => _servers.Where(server => server.Connected && Picked.Ids.Contains(server.PickKey));

    private string ReportSummary
    {
        get
        {
            if (_results is null) return "";
            int included = _results.Count(result => result.Snapshot is not null);
            return $"{included} of {_results.Count} servers answered";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadServersAsync(Closing.Token);
        foreach (ServerInfo server in _servers.Where(server => server.Connected))
            Picked.Ids.Add(server.PickKey);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _ = PageShared.RefreshEveryAsync(TimeSpan.FromSeconds(15), Closing.Token, () => LoadServersAsync(Closing.Token));
    }

    private async Task LoadServersAsync(CancellationToken token)
    {
        if (_busy) return;

        try
        {
            ServerListResponse response = await SdkClient.RequestAsync<ServerListResponse>(JS, UiOperations.Servers, new EmptyPayload(), token);
            _servers = response.Servers;
            Picked.Keep(_servers);
            _error = null;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception e)
        {
            Log.LogDebug(e, "Could not read the PB Limiter server list");
            if (PageShared.ReportReadFailures.IsNew("report-servers", e.Message))
                Log.LogWarning(e, "Could not read the PB Limiter server list");
            _error = "Could not read the server list: " + PageShared.ShortError(e);
        }

        await PageShared.RenderIfOpenAsync(Closing, () => InvokeAsync(StateHasChanged));
    }

    private void ServersPicked()
    {
        _picks++;
        ReportOutdated();
    }

    private void ReportOutdated()
    {
        _results = null;
        _reportText = null;
    }

    private async Task GenerateAsync()
    {
        _busy = true;
        ReportOutdated();
        _progress.Clear();
        int picks = _picks;

        // Taken before waiting: the connected list can change meanwhile, and each server must be listed exactly once.
        List<ServerInfo> asked = SelectedConnected.ToList();
        HashSet<string> askedIds = asked.Select(server => server.ServerId).ToHashSet(StringComparer.Ordinal);
        List<ServerInfo> notAsked = _servers
            .Where(server => Picked.Ids.Contains(server.PickKey) && !askedIds.Contains(server.ServerId))
            .ToList();

        foreach (ServerInfo server in asked)
            _progress[server.ServerId] = "Waiting";
        foreach (ServerInfo server in notAsked)
            _progress[server.ServerId] = "Offline";

        // Each server answers on its own game thread, so a slow one need not hold up the others.
        List<Task<ServerReport>> pending = asked.Select(ReadServerWithProgressAsync).ToList();
        List<ServerReport> reports = new(pending.Count);

        while (pending.Count > 0)
        {
            Task<ServerReport> finished = await Task.WhenAny(pending);
            pending.Remove(finished);
            reports.Add(await finished);
            await InvokeAsync(StateHasChanged);
        }

        if (Closing.IsClosed) return;
        if (picks != _picks)
        {
            // The ticks changed meanwhile: this report is for servers no longer picked.
            _busy = false;
            return;
        }

        IEnumerable<ServerReport> offline = notAsked.Select(server => new ServerReport(server.DisplayName, null, "the server is offline"));

        _results = reports.Concat(offline).OrderBy(result => result.ServerName, StringComparer.OrdinalIgnoreCase).ToList();
        if (_results.Any(result => result.Snapshot is not null))
        {
            DateTime now = DateTime.UtcNow;
            _reportText = CombinedReport.Build(_results, now);
            _fileName = string.Create(CultureInfo.InvariantCulture, $"pb-limiter-report-{now:yyyyMMdd-HHmmss}.txt");
            ToastService.Show("Report generated.", ToastTone.Success, 3);
        }
        else
        {
            ToastService.Show("None of the selected servers answered.", ToastTone.Warning);
        }

        _busy = false;
    }

    private async Task<ServerReport> ReadServerWithProgressAsync(ServerInfo server)
    {
        SetProgress(server, "Reading…");
        ServerReport report = await ReadServerAsync(server);
        SetProgress(server, report.Snapshot is null ? "Not included" : "Done");
        return report;
    }

    private void SetProgress(ServerInfo server, string state)
    {
        _progress[server.ServerId] = state;
        _ = InvokeAsync(StateHasChanged);
    }

    private static string ProgressTone(string state) => state switch
    {
        "Done" => "success",
        "Reading…" => "info",
        "Offline" or "Not included" => "danger",
        _ => ""
    };

    private async Task<ServerReport> ReadServerAsync(ServerInfo server)
    {
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(Closing.Token);
        timeout.CancelAfter(RequestTimeout);
        try
        {
            ReportSnapshotView snapshot = await SdkClient.RequestAsync<ReportSnapshotView>(JS, UiOperations.Snapshot,
                new ReadSnapshotRequest { ServerId = server.ServerId }, timeout.Token);
            if (!snapshot.Installed) return new ServerReport(server.DisplayName, null, "Advanced PB Limiter is not loaded");
            if (!snapshot.Online) return new ServerReport(server.DisplayName, null, "the world is still loading");
            return new ServerReport(server.DisplayName, snapshot, null);
        }
        catch (OperationCanceledException)
        {
            return new ServerReport(server.DisplayName, null, "it did not answer in time");
        }
        catch (Exception e)
        {
            Log.LogDebug(e, "Could not read the PB Limiter report of {Server}", server.DisplayName);
            if (PageShared.ReportReadFailures.IsNew(server.ServerId, e.Message))
                Log.LogWarning(e, "Could not read the PB Limiter report of {Server}", server.DisplayName);
            return new ServerReport(server.DisplayName, null, CompanionErrors.InSentence(PageShared.ShortError(e)) + CompanionErrors.RestartHint(e));
        }
    }

    private async Task DownloadAsync()
    {
        if (_reportText is null) return;

        try
        {
            _download ??= await ImportAsync("download.js");
            await _download.InvokeVoidAsync("downloadText", _fileName, _reportText);
            ToastService.Show("Report downloaded.", ToastTone.Success, 2);
        }
        catch (Exception e)
        {
            _error = "Could not save the report: " + PageShared.ShortError(e);
            ToastService.Show(_error, ToastTone.Danger);
        }
    }

    private async Task DownloadCsvAsync()
    {
        if (_results is null) return;

        try
        {
            string csv = CsvExport.ForServers(_results);
            if (string.IsNullOrWhiteSpace(csv))
            {
                _error = "No blocks were included, so there is no CSV to save.";
                ToastService.Show(_error, ToastTone.Warning);
                return;
            }

            _download ??= await ImportAsync("download.js");
            string fileName = _fileName.Replace(".txt", ".csv", StringComparison.OrdinalIgnoreCase);
            await _download.InvokeVoidAsync("downloadText", fileName, "\uFEFF" + csv, "text/csv;charset=utf-8");
            ToastService.Show("CSV downloaded.", ToastTone.Success, 2);
        }
        catch (Exception e)
        {
            _error = "Could not save the CSV: " + PageShared.ShortError(e);
            ToastService.Show(_error, ToastTone.Danger);
        }
    }

    private async Task CopyReportAsync()
    {
        if (_reportText is null) return;

        try
        {
            _clipboard ??= await ImportAsync("clipboard.js");
            await _clipboard.InvokeVoidAsync("copy", _reportText);
            ToastService.Show("Report copied to the clipboard.", ToastTone.Success, 2);
        }
        catch (Exception e)
        {
            _error = "Could not copy the report: " + PageShared.ShortError(e);
            ToastService.Show(_error, ToastTone.Danger);
        }
    }

    private async Task<IJSObjectReference> ImportAsync(string file)
    {
        string url = new Uri(new Uri(Navigation.BaseUri),
            $"_quasar/plugins/{SdkClient.PluginId}/{file}").ToString();
        return await JS.InvokeAsync<IJSObjectReference>("import", url);
    }

    private void ClearError() => _error = null;

    public async ValueTask DisposeAsync()
    {
        Closing.Dispose();
        await DisposeModuleAsync(_download);
        await DisposeModuleAsync(_clipboard);
    }

    private static async Task DisposeModuleAsync(IJSObjectReference? module)
    {
        if (module is null) return;

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is gone.
        }
        catch (ObjectDisposedException)
        {
            // Already disposed.
        }
    }
}
