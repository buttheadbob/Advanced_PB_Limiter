@page "/advanced-pb-limiter/profiles"
@attribute [Authorize(Policy = "CanEditConfigs")]
@implements IDisposable
@inject IJSRuntime JS
@inject ILogger<ProfilesPage> Log
@using System.Globalization

<PageTitle>PB Limiter profiles</PageTitle>

@{
    // Read once per render from the last state the worker returned.
    List<SavedProfileRow> profiles = _state?.Profiles ?? new();
    List<ServerInfo> knownServers = ServerInfos();
    List<PendingApplyRow> waiting = _state?.Pending ?? new();
    List<AppliedProfile> recent = _state?.Applied ?? new();
    List<ServerInfo> offline = OfflineServers(knownServers);
    List<SavedProfileRow> filteredProfiles = FilteredProfiles(profiles);
}

<PageTabs Active="PageTabs.Tab.Profiles" Description="Set up one server on its Plugins page, save it here as a profile, then apply it to your other servers. Applying replaces every limiter setting and the privileged players on the server.">
    @if (!CanSave)
    {
        <PblNotice Tone="danger" Icon="alert">The profiles file could not be read when Quasar started, so nothing here is saved. Changes are lost when Quasar restarts. The Quasar log has the reason.</PblNotice>
    }
    @if (_error is not null)
    {
        <PblNotice Tone="danger" Icon="alert" Dismiss="ClearError">@_error</PblNotice>
    }
    @if (_notice is not null)
    {
        <PblNotice Tone="success" Icon="check" Dismiss="ClearNotice">@_notice</PblNotice>
    }

    <div class="pbl-profiles-layout">
        <div class="pbl-stack">
            <PblCard Title="Save a profile" Subtitle="Copy the limiter settings and privileged players from a running server.">
                @if (Connected.Count == 0)
                {
                    <PblEmptyState Icon="server" Title="No connected servers" Description="A profile is saved from a server that is running and connected to Quasar." />
                }
                else
                {
                    <div class="pbl-form-grid">
                        <label class="pbl-field pbl-span-2">
                            <span>Copy settings from</span>
                            <select @bind="_sourceKey">
                                <option value="">Choose a server</option>
                                @foreach (ServerInfo server in Connected)
                                {
                                    <option value="@server.PickKey" @key="server.ServerId">@server.DisplayName</option>
                                }
                            </select>
                        </label>

                        <label class="pbl-field pbl-span-2">
                            <span>Profile name</span>
                            <input @bind="_newName" @bind:event="oninput" maxlength="@MaxNameLength" placeholder="For example Survival servers" />
                        </label>

                        <div class="pbl-span-2 pbl-buttons">
                            <button type="button" class="pbl-btn pbl-btn-primary"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_newName) || string.IsNullOrEmpty(_sourceKey))"
                                    @onclick="SaveProfileAsync">
                                <PblIcon Name="plus" />
                                @(NameExists(profiles) ? "Replace profile" : "Save profile")
                            </button>
                            <span class="pbl-muted">The name is replaced if it already exists.</span>
                        </div>
                    </div>
                }
                @if (HidesClusterNodes)
                {
                    <p class="pbl-muted">@ClusterNodesNote</p>
                }
            </PblCard>

            <PblCard Title="Saved profiles" Subtitle="@($"{profiles.Count} saved")">
                @if (profiles.Count == 0)
                {
                    <PblEmptyState Icon="layers" Title="No profiles yet" Description="Save a running server's settings to reuse them on the rest of your network." />
                }
                else
                {
                    <div class="pbl-filterbar">
                        <label class="pbl-search">
                            <PblIcon Name="search" />
                            <input type="search" placeholder="Filter profiles" value="@_profileFilter" @oninput="ProfileFilterChanged" />
                        </label>
                    </div>

                    @if (filteredProfiles.Count == 0)
                    {
                        <PblEmptyState Icon="search" Title="No profiles match" Description="Try a different profile name or source server." />
                    }
                    else
                    {
                        <div class="pbl-profile-list">
                            @foreach (SavedProfileRow profile in filteredProfiles)
                            {
                                <div class="pbl-profile-row @(_applyProfile == profile.Name ? "selected" : "")" @key="profile.Name">
                                    <button type="button" class="pbl-profile-main" @onclick="() => SelectProfile(profile.Name)">
                                        <strong>@profile.Name</strong>
                                        <span>@profile.SavedFrom · @FormatTime(profile.SavedUtc)</span>
                                    </button>

                                    <div class="pbl-profile-meta">
                                        <PblBadge Text="@ProfileSettingsText(profile)" Tone="neutral" />
                                        <PblBadge Text="@ProfilePrivilegedText(profile)" Tone="info" />
                                    </div>

                                    <div class="pbl-profile-actions">
                                        <button type="button" class="pbl-btn pbl-btn-small" @onclick="() => SelectProfile(profile.Name)">Select</button>
                                        <button type="button" class="pbl-icon-btn pbl-icon-btn-danger" title="Delete" aria-label="Delete profile"
                                                @onclick="() => _deleting = profile.Name">
                                            <PblIcon Name="trash" />
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </PblCard>
        </div>

        <div class="pbl-stack">
            <PblCard Title="Apply a profile" Subtitle="Apply one saved profile to one or more servers.">
                @if (profiles.Count == 0)
                {
                    <p class="pbl-muted">Save a profile first.</p>
                }
                else if (knownServers.Count == 0)
                {
                    <PblEmptyState Icon="server" Title="No servers yet" Description="A server is listed here once it has connected to Quasar." />
                }
                else
                {
                    <label class="pbl-field">
                        <span>Profile</span>
                        <select @bind="_applyProfile" disabled="@_confirmingApply">
                            <option value="">Choose a profile</option>
                            @foreach (SavedProfileRow profile in profiles)
                            {
                                <option value="@profile.Name" @key="profile.Name">@profile.Name</option>
                            }
                        </select>
                    </label>

                    <div style="margin-top: 10px;">
                        <PblServerPicker Servers="knownServers" Selected="Picked.Ids" Changed="ServersPicked" />
                    </div>
                    @if (HidesClusterNodes)
                    {
                        <p class="pbl-muted" style="margin-top: 8px;">@ClusterNodesNote</p>
                    }

                    <div class="pbl-buttons" style="margin-top: 12px;">
                        <button type="button" class="pbl-btn pbl-btn-primary"
                                disabled="@(string.IsNullOrEmpty(_applyProfile) || Picked.Ids.Count == 0)"
                                @onclick="() => _confirmingApply = true">
                            <PblIcon Name="check" /> Apply
                        </button>
                        <span class="pbl-muted">A server that is offline or still loading gets the profile when it is ready.</span>
                    </div>
                }
            </PblCard>

            <PblCard Title="Waiting to apply" Subtitle="@($"{waiting.Count} queued")">
                @if (waiting.Count == 0)
                {
                    <p class="pbl-muted">Nothing is waiting to apply.</p>
                }
                else
                {
                    <div class="pbl-timeline">
                        @foreach (PendingApplyRow pending in waiting)
                        {
                            <div class="pbl-timeline-row" @key="pending.Id">
                                <span class="pbl-timeline-dot @StateTone(pending)"></span>
                                <div class="pbl-timeline-main">
                                    <strong>@pending.ProfileName → @pending.ServerName</strong>
                                    <small>@FormatTime(pending.QueuedUtc) · @pending.QueuedBy</small>
                                    <small>@StateText(pending)</small>
                                </div>
                                <div class="pbl-timeline-actions">
                                    <button type="button" class="pbl-btn pbl-btn-small" @onclick="() => _cancelPending = pending">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </PblCard>

            @if (offline.Count > 0)
            {
                <PblCard Title="Offline servers" Subtitle="@($"{offline.Count} known")">
                    <p class="pbl-muted" style="margin-bottom: 8px;">Servers seen before that are not connected now. Forget one that is gone for good; anything waiting for it is dropped.</p>
                    <div class="pbl-timeline">
                        @foreach (ServerInfo server in offline)
                        {
                            <div class="pbl-timeline-row" @key="server.ServerId">
                                <span class="pbl-timeline-dot"></span>
                                <div class="pbl-timeline-main">
                                    <strong>@server.DisplayName</strong>
                                    <small>Last seen @FormatTime(server.LastSeenUtc)</small>
                                </div>
                                <div class="pbl-timeline-actions">
                                    <button type="button" class="pbl-btn pbl-btn-small" @onclick="() => _forgetting = server.ServerId">Forget</button>
                                </div>
                            </div>
                        }
                    </div>
                </PblCard>
            }

            @if (recent.Count > 0)
            {
                <PblCard Title="Recently applied" Subtitle="The newest applications are kept">
                    <div class="pbl-timeline">
                        @foreach (AppliedProfile applied in recent)
                        {
                            <div class="pbl-timeline-row" @key="@($"{applied.ServerName}:{applied.ProfileName}:{applied.AppliedUtc.Ticks}")">
                                <span class="pbl-timeline-dot success"></span>
                                <div class="pbl-timeline-main">
                                    <strong>@applied.ProfileName → @applied.ServerName</strong>
                                    <small>@FormatTime(applied.AppliedUtc) · @applied.QueuedBy</small>
                                    <small>@applied.Settings settings · @applied.PrivilegedPlayers privileged</small>
                                </div>
                            </div>
                        }
                    </div>
                </PblCard>
            }
        </div>
    </div>

    <PblModal Open="_deleting is not null" Title="Delete profile" Subtitle="Anything already waiting to apply still goes ahead." Icon="trash"
              OnClose="CloseDelete" Class="pbl-modal-narrow">
        <p>Delete <strong>@_deleting</strong>? This cannot be undone.</p>
        <div class="pbl-buttons" style="margin-top: 14px; justify-content: flex-end;">
            <button type="button" class="pbl-btn" @onclick="CloseDelete">Cancel</button>
            <button type="button" class="pbl-btn pbl-btn-danger" @onclick="ConfirmDeleteAsync" disabled="@_busy">
                <PblIcon Name="trash" /> Delete
            </button>
        </div>
    </PblModal>

    <PblModal Open="_confirmingApply" Title="Apply profile" Subtitle="This replaces the limiter settings and privileged players on the chosen servers." Icon="check"
              OnClose="CloseApply" Class="pbl-modal-narrow">
        <p>Apply <strong>@_applyProfile</strong> to @InvariantText.Count(Picked.Ids.Count, "server", "servers")?</p>
        <p class="pbl-muted" style="margin-top: 8px;">A server that is offline or still loading gets the profile when it is ready, as the profile was when you confirmed it.</p>
        <div class="pbl-buttons" style="margin-top: 14px; justify-content: flex-end;">
            <button type="button" class="pbl-btn" @onclick="CloseApply">Cancel</button>
            <button type="button" class="pbl-btn pbl-btn-primary" @onclick="ApplyAsync" disabled="@_busy">
                <PblIcon Name="check" /> Apply
            </button>
        </div>
    </PblModal>

    <PblModal Open="_cancelPending is not null" Title="Cancel queued apply" Subtitle="If it is already being sent, it cannot be stopped." Icon="x"
              OnClose="CloseCancelPending" Class="pbl-modal-narrow">
        <p>Cancel <strong>@_cancelPending?.ProfileName</strong> for <strong>@_cancelPending?.ServerName</strong>?</p>
        <div class="pbl-buttons" style="margin-top: 14px; justify-content: flex-end;">
            <button type="button" class="pbl-btn" @onclick="CloseCancelPending">Keep waiting</button>
            <button type="button" class="pbl-btn pbl-btn-danger" @onclick="ConfirmCancelPendingAsync" disabled="@_busy">
                Cancel it
            </button>
        </div>
    </PblModal>

    <PblModal Open="_forgetting is not null" Title="Forget server" Subtitle="Anything waiting for it is dropped." Icon="trash"
              OnClose="CloseForget" Class="pbl-modal-narrow">
        <p>Forget <strong>@ForgetServerName</strong>? It comes back if it connects again.</p>
        <div class="pbl-buttons" style="margin-top: 14px; justify-content: flex-end;">
            <button type="button" class="pbl-btn" @onclick="CloseForget">Cancel</button>
            <button type="button" class="pbl-btn pbl-btn-danger" @onclick="ConfirmForgetAsync" disabled="@_busy">
                Forget
            </button>
        </div>
    </PblModal>
</PageTabs>

@code {
    private const int MaxNameLength = 64;
    private const string NotSavedText = " It was not saved to disk: unless a later change is saved, it is lost when Quasar restarts; the Quasar log has the reason.";
    private static readonly TimeSpan RequestTimeout = TimeSpan.FromSeconds(20);

    private readonly PageClosing Closing = new();
    private ProfilesStateResponse? _state;
    private string? _sourceKey;
    private bool _sourceInitialized;
    private string _newName = "";
    private string _applyProfile = "";
    private string _profileFilter = "";
    private string? _deleting;
    private string? _forgetting;
    private PendingApplyRow? _cancelPending;
    private string? _error;
    private string? _notice;
    private bool _confirmingApply;
    private bool _busy;

    private PickedServers Picked { get; } = new();
    // Quasar cluster nodes are left out: the limiter does not run on them, so a profile can neither be saved from nor applied to one.
    private IReadOnlyList<ServerInfo> Connected => _state is null ? Array.Empty<ServerInfo>() : _state.ConnectedServers.FindAll(s => !IsClusterNode(s.ClusterId));

    private static bool IsClusterNode(string? clusterId) => !string.IsNullOrEmpty(clusterId);

    private bool HidesClusterNodes => _state is not null
                                      && (_state.ConnectedServers.Exists(s => IsClusterNode(s.ClusterId)) || _state.KnownServers.Exists(s => IsClusterNode(s.ClusterId)));

    private const string ClusterNodesNote = "Quasar cluster nodes are not listed: Advanced PB Limiter does not run on them.";
    private bool CanSave => _state?.CanSave ?? true;

    private string ForgetServerName =>
        _forgetting is null ? "" :
        ServerInfos().FirstOrDefault(server => server.ServerId == _forgetting)?.DisplayName ?? _forgetting;

    protected override async Task OnInitializedAsync()
    {
        await LoadStateAsync(Closing.Token);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _ = PageShared.RefreshEveryAsync(TimeSpan.FromSeconds(5), Closing.Token, () => LoadStateAsync(Closing.Token));
    }

    private async Task LoadStateAsync(CancellationToken token)
    {
        try
        {
            ProfilesStateResponse state = await SdkClient.RequestAsync<ProfilesStateResponse>(JS, UiOperations.ProfilesState, new EmptyPayload(), token);
            ApplyState(state);
            _error = null;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception e)
        {
            Log.LogDebug(e, "Could not read the PB Limiter profiles");
            if (PageShared.ReportReadFailures.IsNew("profiles", e.Message))
                Log.LogWarning(e, "Could not read the PB Limiter profiles");
            _error = "Could not read the profiles: " + PageShared.ShortError(e);
        }

        await PageShared.RenderIfOpenAsync(Closing, () => InvokeAsync(StateHasChanged));
    }

    private void ApplyState(ProfilesStateResponse state)
    {
        _state = state;
        Picked.Keep(ServerInfos());
        // Choose the first connected server once. A selection that goes away is cleared, never silently replaced; the
        // page then asks for one. An empty choice ("Choose a server") stays empty until the admin picks one.
        if (string.IsNullOrEmpty(_sourceKey)) _sourceKey = null;
        if (!_sourceInitialized)
        {
            _sourceKey = Connected.FirstOrDefault()?.PickKey;
            _sourceInitialized = Connected.Count > 0;
        }
        else if (_sourceKey is not null && Connected.All(s => s.PickKey != _sourceKey))
        {
            _sourceKey = null;
        }
    }

    /// <summary>The known servers, the connected ones as the worker describes them and the rest as last seen.</summary>
    private List<ServerInfo> ServerInfos()
    {
        if (_state is null) return new();

        HashSet<string> connected = _state.ConnectedServers.Select(s => s.ServerId).ToHashSet(StringComparer.Ordinal);
        List<ServerInfo> all = new(_state.KnownServers.Count + _state.ConnectedServers.Count);
        all.AddRange(Connected);
        foreach (KnownServer known in _state.KnownServers)
        {
            if (connected.Contains(known.ServerId) || IsClusterNode(known.ClusterId)) continue;
            all.Add(new ServerInfo
            {
                ServerId = known.ServerId,
                DisplayName = known.DisplayName,
                ClusterId = known.ClusterId,
                ClusterSlot = known.ClusterSlot,
                LastSeenUtc = known.LastSeenUtc,
                Known = true
            });
        }
        return all.OrderBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private List<ServerInfo> OfflineServers(List<ServerInfo> knownServers) => knownServers.Where(s => !s.Connected).ToList();

    private List<SavedProfileRow> FilteredProfiles(List<SavedProfileRow> profiles)
    {
        string needle = _profileFilter.Trim();
        if (needle.Length == 0) return profiles;

        return profiles
            .Where(profile => profile.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                              || profile.SavedFrom.Contains(needle, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private static string ProfileSettingsText(SavedProfileRow profile) =>
        profile.Settings.ToString(CultureInfo.InvariantCulture) + " settings";

    private static string ProfilePrivilegedText(SavedProfileRow profile) =>
        profile.PrivilegedPlayers.ToString(CultureInfo.InvariantCulture) + " privileged";

    /// <summary>What a queued request is doing, for its row, with a note when an earlier send may already have applied it.</summary>
    private static string StateText(PendingApplyRow pending)
    {
        if (pending.Sending) return "Sending now.";
        if (pending.Refused) return "Refused, not sent again: " + pending.LastError;
        string state = pending.LastError ?? "Waiting to be sent.";
        if (!pending.MayBeApplied) return state;
        return state.TrimEnd().TrimEnd('.') + ". An earlier send may already have applied it.";
    }

    private static string StateTone(PendingApplyRow pending)
    {
        if (pending.Refused) return "danger";
        if (pending.Sending) return "info";
        if (pending.MayBeApplied || pending.LastError is not null) return "warning";
        return "";
    }

    private bool NameExists(List<SavedProfileRow> profiles)
    {
        string name = _newName.Trim();
        return profiles.Exists(p => string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase));
    }

    private void ProfileFilterChanged(ChangeEventArgs args) =>
        _profileFilter = args.Value?.ToString() ?? "";

    private void SelectProfile(string name) => _applyProfile = name;

    private void ClearError() => _error = null;
    private void ClearNotice() => _notice = null;
    private void CloseDelete() => _deleting = null;
    private void CloseApply() => _confirmingApply = false;
    private void CloseCancelPending() => _cancelPending = null;
    private void CloseForget() => _forgetting = null;

    private async Task<bool> CanEditAsync()
    {
        try
        {
            if (await SdkClient.AllowedAsync(JS, "CanEditConfigs", Closing.Token))
                return true;
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not check the PB Limiter edit permission");
            _error = "Could not check your permission: " + PageShared.ShortError(e);
            return false;
        }

        _error = "You do not have permission to edit configurations.";
        _notice = null;
        return false;
    }

    private async Task SaveProfileAsync()
    {
        string name = _newName.Trim();
        string? sourceKey = string.IsNullOrEmpty(_sourceKey) ? null : _sourceKey;
        if (name.Length == 0 || sourceKey == null) return;
        ServerInfo? source = Connected.FirstOrDefault(s => s.PickKey == sourceKey);
        if (source is null)
        {
            _error = "That server is no longer connected. Choose another one.";
            return;
        }
        string serverId = source.ServerId;
        if (!name.IsSafeProfileName())
        {
            _error = "The profile name must be 1 to 64 characters, with no control or hidden formatting characters.";
            _notice = null;
            return;
        }
        if (!await CanEditAsync()) return;

        _busy = true;
        _error = null;
        _notice = null;
        string serverName = source.DisplayName;
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(Closing.Token);
        timeout.CancelAfter(RequestTimeout);
        try
        {
            ProfileActionResult result = await SdkClient.RequestAsync<ProfileActionResult>(JS, UiOperations.ProfileSave,
                new ProfileSaveRequest { ServerId = serverId, Name = name }, timeout.Token);
            ApplyResult(result);
            if (result.Changed)
            {
                Log.LogInformation("Saved PB Limiter profile {Profile} from {Server}", name, serverName);
                _newName = "";
            }
        }
        catch (OperationCanceledException) when (Closing.IsClosed)
        {
            // The page closed.
        }
        catch (OperationCanceledException)
        {
            _error = $"{serverName} did not answer in time, so {name} was not saved.";
            ToastService.Show(_error, ToastTone.Warning);
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not save PB Limiter profile {Profile} from {Server}", name, serverName);
            _error = $"Could not read the settings of {serverName}, so {name} was not saved: {PageShared.ShortError(e)}{CompanionErrors.RestartHint(e)}";
            ToastService.Show(_error, ToastTone.Danger);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        string? name = _deleting;
        _deleting = null;
        if (name is null) return;

        SavedProfileRow? profile = _state?.Profiles.FirstOrDefault(p => p.Name == name);
        if (profile is not null)
            await DeleteProfileAsync(profile);
    }

    private async Task DeleteProfileAsync(SavedProfileRow profile)
    {
        if (!await CanEditAsync()) return;

        try
        {
            ProfileActionResult result = await SdkClient.RequestAsync<ProfileActionResult>(JS, UiOperations.ProfileDelete,
                new ProfileNameRequest { Name = profile.Name }, Closing.Token);
            ApplyResult(result);
            if (string.Equals(_applyProfile, profile.Name, StringComparison.OrdinalIgnoreCase))
            {
                _applyProfile = "";
                _confirmingApply = false;
            }
            if (result.Changed)
                Log.LogInformation("Deleted PB Limiter profile {Profile}", profile.Name);
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not delete PB Limiter profile {Profile}", profile.Name);
            _error = "Could not delete the profile: " + PageShared.ShortError(e);
            ToastService.Show(_error, ToastTone.Danger);
        }
    }

    private async Task ApplyAsync()
    {
        _confirmingApply = false;
        if (!await CanEditAsync()) return;

        _busy = true;
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(Closing.Token);
        timeout.CancelAfter(RequestTimeout);
        try
        {
            ProfileActionResult result = await SdkClient.RequestAsync<ProfileActionResult>(JS, UiOperations.ProfileQueue,
                new ProfileQueueRequest { ProfileName = _applyProfile, ServerKeys = Picked.Ids.ToList() }, timeout.Token);
            ApplyResult(result);
            if (result.Changed)
            {
                Log.LogInformation("Queued PB Limiter profile {Profile}", _applyProfile);
                Picked.Clear();
            }
        }
        catch (OperationCanceledException) when (Closing.IsClosed)
        {
            // The page closed.
        }
        catch (OperationCanceledException)
        {
            _error = "The request did not answer in time, so it was not queued.";
            ToastService.Show(_error, ToastTone.Warning);
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not queue PB Limiter profile {Profile}", _applyProfile);
            _error = "Could not queue the profile: " + PageShared.ShortError(e);
            ToastService.Show(_error, ToastTone.Danger);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ServersPicked()
    {
        _confirmingApply = false;
    }

    private async Task ConfirmCancelPendingAsync()
    {
        PendingApplyRow? pending = _cancelPending;
        _cancelPending = null;
        if (pending is null) return;
        await CancelPendingAsync(pending);
    }

    private async Task CancelPendingAsync(PendingApplyRow pending)
    {
        if (!await CanEditAsync()) return;

        try
        {
            ProfileActionResult result = await SdkClient.RequestAsync<ProfileActionResult>(JS, UiOperations.ProfileCancel,
                new ProfileCancelRequest { Id = pending.Id }, Closing.Token);
            ApplyResult(result);
            if (result.Changed)
                Log.LogInformation("Cancelled PB Limiter profile {Profile} for {Server}", pending.ProfileName, pending.ServerName);
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not cancel PB Limiter profile {Profile} for {Server}", pending.ProfileName, pending.ServerName);
            _error = "Could not cancel the request: " + PageShared.ShortError(e);
            ToastService.Show(_error, ToastTone.Danger);
        }
    }

    private async Task ConfirmForgetAsync()
    {
        string? id = _forgetting;
        _forgetting = null;
        if (id is null) return;

        ServerInfo? server = ServerInfos().FirstOrDefault(s => s.ServerId == id);
        if (server is not null)
            await ForgetServerAsync(server);
    }

    private async Task ForgetServerAsync(ServerInfo server)
    {
        if (!await CanEditAsync()) return;

        try
        {
            ProfileActionResult result = await SdkClient.RequestAsync<ProfileActionResult>(JS, UiOperations.ProfileForget,
                new ProfileForgetRequest { ServerId = server.ServerId }, Closing.Token);
            ApplyResult(result);
            if (result.Changed)
            {
                Picked.Deselect(server);
                Log.LogInformation("Forgot PB Limiter server {Server} ({Id})", server.DisplayName, server.ServerId);
            }
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not forget PB Limiter server {Server}", server.DisplayName);
            _error = "Could not forget the server: " + PageShared.ShortError(e);
            ToastService.Show(_error, ToastTone.Danger);
        }
    }

    private void ApplyResult(ProfileActionResult result)
    {
        ApplyState(result.State);
        if (result.Changed && result.Saved)
        {
            _notice = result.Message;
            _error = null;
            ToastService.Show(result.Message, ToastTone.Success);
        }
        else if (result.Changed)
        {
            _notice = null;
            _error = result.Message + NotSavedText;
            ToastService.Show(result.Message + " Not saved to disk.", ToastTone.Warning);
        }
        else
        {
            _notice = null;
            _error = result.Message;
            ToastService.Show(result.Message, ToastTone.Danger);
        }
    }

    private static string FormatTime(DateTime utc) => utc.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) + " UTC";

    public void Dispose()
    {
        Closing.Dispose();
    }
}
