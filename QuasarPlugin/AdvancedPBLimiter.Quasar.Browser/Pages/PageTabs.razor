@implements IDisposable
@inject IJSRuntime JS
@inject ILogger<PageTabs> Log

<div class="pbl-page">
    <header class="pbl-page-heading">
        <div class="pbl-page-intro">
            <div class="pbl-eyebrow">Plugins</div>
            <h1>Advanced PB Limiter</h1>
            <p class="pbl-page-description">@Description</p>
        </div>
        @if (HeaderActions is not null)
        {
            <div class="pbl-page-actions">@HeaderActions</div>
        }
    </header>

    <nav class="pbl-subnav" aria-label="Advanced PB Limiter">
        <a class="pbl-subnav-link @ActiveClass(Tab.Live)" href="@LimiterRoutes.Live.TrimStart('/')" aria-current="@Current(Tab.Live)">
            <PblIcon Name="activity" />
            <span>Live view</span>
        </a>
        @if (_canEdit)
        {
            <a class="pbl-subnav-link @ActiveClass(Tab.Profiles)" href="@LimiterRoutes.Profiles.TrimStart('/')" aria-current="@Current(Tab.Profiles)">
                <PblIcon Name="sliders" />
                <span>Profiles</span>
            </a>
        }
        <a class="pbl-subnav-link @ActiveClass(Tab.Report)" href="@LimiterRoutes.Report.TrimStart('/')" aria-current="@Current(Tab.Report)">
            <PblIcon Name="file" />
            <span>Generate report</span>
        </a>
    </nav>

    @ChildContent

    <PblToastHost />
</div>

@code {
    public enum Tab { Live, Profiles, Report }

    [Parameter, EditorRequired] public Tab Active { get; set; }
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }

    // The worker checks CanEditConfigs on the page and on every profile operation; this only hides a link the user
    // cannot use. It is asked through the SDK because the browser dashboard has no ASP.NET authorization state.
    private readonly PageClosing _closing = new();
    private bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _canEdit = await SdkClient.AllowedAsync(JS, "CanEditConfigs", _closing.Token);
        }
        catch (Exception e)
        {
            Log.LogWarning(e, "Could not check the PB Limiter edit permission");
            _canEdit = false;
        }
    }

    private string ActiveClass(Tab tab) => tab == Active ? "active" : "";

    private string? Current(Tab tab) => tab == Active ? "page" : null;

    public void Dispose() => _closing.Dispose();
}
