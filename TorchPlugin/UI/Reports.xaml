<UserControl x:Class="Advanced_PB_Limiter.UI.Reports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Advanced_PB_Limiter.UI"
             xmlns:reports="clr-namespace:Advanced_PB_Limiter.Utils.Reports"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{DynamicResource WhiteBrush}"
             Foreground="{DynamicResource BlackBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PblStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="2">

        <Border Style="{StaticResource Pbl.Toolbar}">
            <WrapPanel>
                <Button Name="EnableLiveViewButton" Content="Enable live view" Style="{StaticResource Pbl.AccentButton}"
                        ToolTip="Live reporting; disabled after restarts by default" Margin="0,0,5,4" Click="EnableLiveViewButton_OnClick" />
                <Button Name="DisableLiveViewButton" Content="Disable" Style="{StaticResource Pbl.GhostButton}"
                        ToolTip="Stop live reporting; the last data stays on screen" Margin="0,0,5,4" Click="DisableLiveViewButton_OnClick" />
                <Button Name="ManualUpdateButton" Content="Refresh" ToolTip="Refresh the report now" Margin="0,0,5,4" Click="ManualUpdateButton_OnClick" />
                <Button Name="GenerateTextReport" Content="Regenerate and save" ToolTip="Build a fresh report and save it to a text file" Margin="0,0,5,4" Click="GenerateTextReport_OnClick" />
                <Button Name="SaveCurrentReport" Content="Save current" ToolTip="Save the report currently on screen" Margin="0,0,5,4" Click="SaveCurrentReport_OnClick" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,4">
                    <TextBlock Text="Refresh" Style="{StaticResource Pbl.MutedText}" VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBox Name="RefreshRateTextBox" Text="5" Width="42" TextAlignment="Center"
                             ToolTip="Seconds between live updates; 0.1 to 3600. Default 5." Margin="0,0,3,0" />
                    <TextBlock Text="s" Style="{StaticResource Pbl.MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Name="ShowRestingCheckBox" Content="Show resting" IsChecked="True" VerticalAlignment="Center"
                              ToolTip="Resting blocks are kept for their history, but have not run lately. Hide them to focus on current activity."
                              Checked="ShowResting_OnChanged" Unchecked="ShowResting_OnChanged" Margin="0,0,12,0" />
                    <TextBlock Name="LiveStatusText" Text="Stopped" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <WrapPanel Name="SummaryTiles" Margin="0,0,0,2">
            <Border Style="{StaticResource Pbl.Tile}">
                <StackPanel>
                    <TextBlock Text="Programmable blocks" Style="{StaticResource Pbl.TileLabel}" />
                    <TextBlock Name="TotalBlocksText" Text="0" Style="{StaticResource Pbl.TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Pbl.Tile}">
                <StackPanel>
                    <TextBlock Text="Active" Style="{StaticResource Pbl.TileLabel}" />
                    <TextBlock Name="ActiveBlocksText" Text="0" Style="{StaticResource Pbl.TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Pbl.Tile}">
                <StackPanel>
                    <TextBlock Text="Resting" Style="{StaticResource Pbl.TileLabel}" />
                    <TextBlock Name="RestingBlocksText" Text="0" Style="{StaticResource Pbl.TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Pbl.Tile}">
                <StackPanel>
                    <TextBlock Text="Players" Style="{StaticResource Pbl.TileLabel}" />
                    <TextBlock Name="PlayersText" Text="0" Style="{StaticResource Pbl.TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Pbl.Tile}">
                <StackPanel>
                    <TextBlock Text="Combined last" Style="{StaticResource Pbl.TileLabel}" />
                    <TextBlock Name="CombinedLastText" Text="0 ms" Style="{StaticResource Pbl.TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Pbl.Tile}">
                <StackPanel>
                    <TextBlock Text="Combined average" Style="{StaticResource Pbl.TileLabel}" />
                    <TextBlock Name="CombinedAvgText" Text="0 ms" Style="{StaticResource Pbl.TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Pbl.Tile}">
                <StackPanel>
                    <TextBlock Text="Offences" Style="{StaticResource Pbl.TileLabel}" />
                    <TextBlock Name="OffencesText" Text="0" Style="{StaticResource Pbl.TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Pbl.Tile}">
                <StackPanel>
                    <TextBlock Text="Recompiles" Style="{StaticResource Pbl.TileLabel}" />
                    <TextBlock Name="RecompilesText" Text="0" Style="{StaticResource Pbl.TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Pbl.Tile}">
                <StackPanel>
                    <TextBlock Text="Memory" Style="{StaticResource Pbl.TileLabel}" />
                    <TextBlock Name="MemoryValueText" Text="0 KB" Style="{StaticResource Pbl.TileValue}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Name="NoticeBorder" Style="{StaticResource Pbl.NoticeDanger}" Visibility="Collapsed">
            <TextBlock Name="NoticeText" TextWrapping="Wrap" />
        </Border>

        <TextBlock Name="UpdatedText" Text="No report read yet." Style="{StaticResource Pbl.MutedText}" Margin="1,0,0,8" />

        <TabControl Name="ReportTabs">
            <TabItem Header="Programmable blocks">
                <DataGrid Name="PerPBDataGrid" Height="430" Margin="0,0,0,2"
                          Style="{StaticResource Pbl.DataGrid}"
                          d:DataContext="{d:DesignInstance Type=reports:CustomBlockReport}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" Width="140"
                                            ElementStyle="{StaticResource Pbl.TextText}" />
                        <DataGridTextColumn Header="Grid" Binding="{Binding GridName}" Width="150"
                                            ElementStyle="{StaticResource Pbl.TextText}" />
                        <DataGridTextColumn Header="Block" Binding="{Binding BlockName}" Width="170"
                                            ElementStyle="{StaticResource Pbl.TextText}" />
                        <DataGridTextColumn Header="Last ms" Binding="{Binding LastRunTimeMS, StringFormat={}{0:0.######}}"
                                            Width="80" ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Avg ms" Binding="{Binding AvgMS, StringFormat={}{0:0.######}}"
                                            Width="80" ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Peak ms" Binding="{Binding PeekRunTimeMS, StringFormat={}{0:0.######}}"
                                            Width="80" ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Offences" Binding="{Binding Offences}" Width="65"
                                            ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Recompiles" Binding="{Binding Recompiles}" Width="90"
                                            ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <!-- Memory is a numeric column and is right aligned like the other figures. Left aligned, a small
                             value started flush against the Recompiles count and the two read as one number. -->
                        <DataGridTextColumn Header="Memory" Binding="{Binding MemoryUsed}" Width="100"
                                            ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridCheckBoxColumn Header="Resting" Binding="{Binding Resting, Mode=OneWay}" Width="58" />
                        <DataGridTemplateColumn Header="" Width="78" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Turn off" Style="{StaticResource Pbl.DangerGhostButton}"
                                            Tag="{Binding pbBlock}" PreviewMouseUp="TurnOff_PB" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Players">
                <DataGrid Name="PerPlayerDataGrid" Height="430" Margin="0,0,0,2"
                          Style="{StaticResource Pbl.DataGrid}"
                          d:DataContext="{d:DesignInstance Type=reports:CustomPlayerReport}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" Width="150"
                                            ElementStyle="{StaticResource Pbl.TextText}" />
                        <DataGridTextColumn Header="Steam ID" Binding="{Binding SteamId}" Width="140"
                                            ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Blocks" Binding="{Binding PbCount}" Width="62"
                                            ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Combined last" Binding="{Binding CombinedLastRunTimeMS, StringFormat={}{0:0.####}}"
                                            Width="105" ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Combined avg" Binding="{Binding CombinedAvgMS, StringFormat={}{0:0.####}}"
                                            Width="110" ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Offences" Binding="{Binding Offences}" Width="65"
                                            ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Recompiles" Binding="{Binding Recompiles}" Width="90"
                                            ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTextColumn Header="Memory" Binding="{Binding MemoryUsed}" Width="100"
                                            ElementStyle="{StaticResource Pbl.NumberText}"
                                            HeaderStyle="{StaticResource Pbl.DataGridHeaderNumber}" CellStyle="{StaticResource Pbl.NumberCell}" />
                        <DataGridTemplateColumn Header="" Width="98" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Turn all off" Style="{StaticResource Pbl.DangerGhostButton}"
                                            Tag="{Binding PlayerTracked}" PreviewMouseUp="TurnOff_AllPB" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </StackPanel>
</UserControl>
