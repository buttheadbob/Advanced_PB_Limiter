<UserControl x:Class="Advanced_PB_Limiter.UI.PrivilegedUsers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Advanced_PB_Limiter.UI"
             mc:Ignorable="d"
             d:DesignHeight="Auto" d:DesignWidth="Auto"
             Background="{DynamicResource WhiteBrush}"
             Foreground="{DynamicResource BlackBrush}">
    <UserControl.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="PblStyles.xaml" />
        </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
</UserControl.Resources>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <GroupBox MinWidth="250">
            <GroupBox.Header>
                <TextBlock>
                    <Span FontWeight="Bold">Privileged Players</Span>
                </TextBlock>
            </GroupBox.Header>
            <DataGrid Name="PrivilegedPlayersGrid" Style="{StaticResource Pbl.DataGrid}" Height="260"
                      HeadersVisibility="Column" ItemsSource="{Binding PrivilegedPlayers.Values}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Player Name"
                                        Width="160"
                                        Binding="{Binding Name}"/> 
                    <DataGridTextColumn Header="SteamID"
                                        Width="160"
                                        Binding="{Binding SteamId}"/> 
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        <GroupBox MinWidth="400">
            <GroupBox.Header>
                <TextBlock>
                    <Span FontWeight="Bold">Privileged Player Settings</Span>
                </TextBlock>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Player Name: " Margin="3"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="PlayerNameBox" Margin="3"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="SteamID: " Margin="3"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="SteamIDBox" Margin="3"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Graceful Shutdown: " Margin="3" ToolTip="Time in seconds from when the script is sent a shutdown request until the punishment is applied. 0 punishes at once, without a request."/>
                <TextBox Grid.Row="2" Grid.Column="1" Name="GracefulShutdownBox" Margin="3"/>
                
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Punishment: " Margin="3"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Name="PunishmentBox" Margin="3" >
                    <ComboBoxItem Content="TurnOff"/>
                    <ComboBoxItem Content="Damage"/>
                    <ComboBoxItem Content="Destroy"/>
                </ComboBox>
                
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Damage Amount: " Margin="3"/>
                <TextBox Grid.Row="4" Grid.Column="1" Name="DamageAmountBox" Margin="3" ToolTip="Only applies when Damage is selected as the punishment type. 0 uses the server's setting."/>
                
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Offences Before Punishment: " Margin="3" ToolTip="0 punishes at the first offence."/>
                <TextBox Grid.Row="5" Grid.Column="1" Name="OffencesBeforePunishmentBox" Margin="3"/>
                
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Max Runtime Allowed [MS] (0 = no limit):" Margin="3"/>
                <TextBox Grid.Row="6" Grid.Column="1" Name="MaxRuntimeAllowedBox" Margin="3"/>
                
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Max Avg Runtime Allowed [MS]: " Margin="3"/>
                <TextBox Grid.Row="7" Grid.Column="1" Name="MaxAVGRuntimeAllowedBox" Margin="3"/>
                
                <TextBlock Grid.Row="8" Grid.Column="0" Text="No Combined Limits: " Margin="3"/>
                <CheckBox Grid.Row="8" Grid.Column="1" Name="NoCombinedLimitsBox" Margin="3"/>
                
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Max Combined Runtime Allowed [MS]: " Margin="3"/>
                <TextBox Grid.Row="9" Grid.Column="1" Name="MaxCombinedRuntimeAllowedBox" Margin="3"/>
                
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Max Combined Avg Runtime Allowed [MS]: " Margin="3"/>
                <TextBox Grid.Row="10" Grid.Column="1" Name="MaxCombinedAVGRuntimeAllowedBox" Margin="3"/>
                
                <TextBlock Grid.Row="11" Grid.Column="0" Text="Startup Time: " Margin="3" ToolTip="The amount of time a pb is ignored before tracking and punishing. 0 uses the server's setting."/>
                <TextBox Grid.Row="11" Grid.Column="1" Name="StartupBox" Margin="3"/>
                
                <Button Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" Content="Load Privileged Player Data" Name="LoadPrivilegedPlayerDataButton" Margin="3" Click="LoadPrivilegedPlayerDataButton_OnClick"/>
                <Button Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Content="Add/Update Privileged User" Name="AddOrUpdateButton" Margin="3" Style="{StaticResource Pbl.AccentButton}" Click="AddOrUpdateButton_OnClick"/>
                <Button Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="2" Content="Remove Privileged User" Name="RemoveButton" Margin="3" Style="{StaticResource Pbl.DangerButton}" Click="RemoveButton_OnClick"/>
            </Grid>
        </GroupBox>
    </StackPanel>
    
</UserControl>
