<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The Torch plugin's look. Every page merges this dictionary, so the settings, privileged players and reports tabs
        share one palette. Torch themes invert BlackBrush/WhiteBrush, so text and window colours use those dynamic keys;
        the surfaces and lines are translucent greys that read on both light and dark themes.
    -->

    <SolidColorBrush x:Key="Pbl.Surface" Color="#16808080" />
    <SolidColorBrush x:Key="Pbl.SurfaceStrong" Color="#28808080" />
    <SolidColorBrush x:Key="Pbl.SurfaceSoft" Color="#0E808080" />
    <SolidColorBrush x:Key="Pbl.Line" Color="#48808080" />
    <SolidColorBrush x:Key="Pbl.LineSoft" Color="#28808080" />
    <SolidColorBrush x:Key="Pbl.Accent" Color="#FF4FC3D9" />
    <SolidColorBrush x:Key="Pbl.AccentSoft" Color="#334FC3D9" />
    <SolidColorBrush x:Key="Pbl.Success" Color="#FF4DBB82" />
    <SolidColorBrush x:Key="Pbl.Warning" Color="#FFE0A83E" />
    <SolidColorBrush x:Key="Pbl.Danger" Color="#FFE26666" />
    <SolidColorBrush x:Key="Pbl.Info" Color="#FF56C8DC" />
    <SolidColorBrush x:Key="Pbl.DangerSoft" Color="#33E26666" />
    <SolidColorBrush x:Key="Pbl.SelectionBackground" Color="#FF1F5F6B" />
    <SolidColorBrush x:Key="Pbl.SelectionForeground" Color="#FFFFFFFF" />

    <FontFamily x:Key="Pbl.Font">Segoe UI</FontFamily>

    <!-- Text ========================================================== -->

    <!-- No Foreground here: a TextBlock inside a Button or TabItem must inherit that control's Foreground, which is how
         the accent and danger buttons keep readable text. The page roots set the base text colour instead. -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Pbl.MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="Opacity" Value="0.62" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Pbl.Heading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2,0,7" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Pbl.TileLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="Opacity" Value="0.62" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Pbl.TileValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Buttons ========================================================== -->

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="Background" Value="{StaticResource Pbl.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pbl.SurfaceStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pbl.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pbl.AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Pbl.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FF10171A" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style x:Key="Pbl.DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Pbl.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Danger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <Style x:Key="Pbl.GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Opacity" Value="0.78" />
        <Setter Property="Padding" Value="7,4" />
    </Style>

    <Style x:Key="Pbl.DangerGhostButton" TargetType="Button" BasedOn="{StaticResource Pbl.GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource Pbl.Danger}" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="FontSize" Value="10" />
        <Style.Triggers>
            <!-- Red on the selected row's dark band is too dim: lighten it there, while the row stays easy to read. -->
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Foreground" Value="#FFFFA3A3" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pbl.IconButton" TargetType="Button" BasedOn="{StaticResource Pbl.GhostButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- Inputs ========================================================== -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="Background" Value="{StaticResource Pbl.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="Background" Value="{StaticResource Pbl.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                        <Path Data="M 0 0 L 4 4 L 8 0"
                                              Stroke="{DynamicResource BlackBrush}" StrokeThickness="1.4"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,9,0" Opacity="0.7" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pbl.SurfaceStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pbl.SurfaceStrong}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- The selected item is drawn over the toggle, which stays clickable beneath it. -->
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Slide"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource WhiteBrush}"
                                    BorderBrush="{StaticResource Pbl.Line}"
                                    BorderThickness="1" CornerRadius="0,0,5,5" Margin="0,2,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pbl.AccentSoft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pbl.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Cards ========================================================== -->

    <Style x:Key="Pbl.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Pbl.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="11" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>

    <Style x:Key="Pbl.Tile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Pbl.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="MinWidth" Value="118" />
    </Style>

    <Style x:Key="Pbl.Toolbar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Pbl.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>

    <Style x:Key="Pbl.Notice" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Pbl.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Info}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>

    <Style x:Key="Pbl.NoticeDanger" TargetType="Border" BasedOn="{StaticResource Pbl.Notice}">
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Danger}" />
    </Style>

    <Style x:Key="Pbl.NoticeWarning" TargetType="Border" BasedOn="{StaticResource Pbl.Notice}">
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Warning}" />
    </Style>

    <!-- GroupBox ========================================================== -->

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="Background" Value="{StaticResource Pbl.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top"
                                              ContentSource="Header"
                                              Margin="0,0,0,8"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.FontSize="14"
                                              TextElement.Foreground="{DynamicResource BlackBrush}" />
                            <ContentPresenter />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs ========================================================== -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,7" />
                        <Border Grid.Row="1" Background="Transparent">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            CornerRadius="5,5,0,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pbl.SurfaceSoft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Pbl.Surface}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Pbl.Accent}" />
                            <!-- The selected header is marked by its underline and surface, not by accent text: accent
                                 text on this light surface is hard to read, and a Foreground on the TabItem also leaks
                                 into the tab's content. -->
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Data grids ========================================================== -->

    <Style x:Key="Pbl.NumberText" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Style.Triggers>
            <!-- A selected grid row is a dark teal band with white text in both themes. The system highlight is a pale
                 wash in the light theme, where its white highlight text is unreadable. -->
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Pbl.SelectionForeground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pbl.TextText" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Pbl.SelectionForeground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pbl.DataGridCell" TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Pbl.SelectionForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pbl.NumberCell" TargetType="DataGridCell" BasedOn="{StaticResource Pbl.DataGridCell}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="Pbl.DataGridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource Pbl.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontFamily" Value="{StaticResource Pbl.Font}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="7,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="Pbl.DataGridHeaderNumber" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Pbl.DataGridHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="Pbl.DataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Pbl.SurfaceSoft}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Pbl.SelectionBackground}" />
                <Setter Property="Foreground" Value="{StaticResource Pbl.SelectionForeground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pbl.DataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BlackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="All" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Pbl.LineSoft}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Pbl.Line}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeight" Value="27" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="False" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Pbl.DataGridHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource Pbl.DataGridCell}" />
        <Setter Property="RowStyle" Value="{StaticResource Pbl.DataGridRow}" />
    </Style>

</ResourceDictionary>
