<UserControl x:Class="Advanced_PB_Limiter.UI.Advanced_PB_LimiterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Advanced_PB_Limiter"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{DynamicResource WhiteBrush}"
             Foreground="{DynamicResource BlackBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PblStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Pbl.Card}" Padding="14,11" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock x:Name="StatusText" Text="Torch" HorizontalAlignment="Right"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetailText" Text="Advanced PB Limiter" HorizontalAlignment="Right"
                               Style="{StaticResource Pbl.MutedText}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Advanced PB Limiter" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Run-time limits, privileged players and live reports for programmable blocks."
                               Style="{StaticResource Pbl.MutedText}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="PluginTabs">
            <TabItem x:Name="MainSettingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>

            <TabItem x:Name="PrivilegedUsersTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Privileged Players" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>

            <TabItem x:Name="ReportsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Reports" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
