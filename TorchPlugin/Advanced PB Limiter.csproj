  <!-- After every build, package the plugin as ..\Build\Advanced PB Limiter.zip (dll, pdb and manifest.xml).
       Staged in obj\ so nothing else ends up in the zip. -->
  <Target Name="PackagePluginZip" AfterTargets="Build">
    <PropertyGroup>
      <PluginZipStage>$(ProjectDir)$(IntermediateOutputPath)PluginZip\</PluginZipStage>
      <PluginZipFile>$(ProjectDir)..\Build\$(TargetName).zip</PluginZipFile>
    </PropertyGroup>
    <RemoveDir Directories="$(PluginZipStage)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb;$(ProjectDir)manifest.xml" DestinationFolder="$(PluginZipStage)" />
    <ZipDirectory SourceDirectory="$(PluginZipStage)" DestinationFile="$(PluginZipFile)" Overwrite="true" />
    <Message Importance="high" Text="Plugin zip: $(PluginZipFile)" />
  </Target>
